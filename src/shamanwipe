def uruchom(cmd, timeout=120, wejscie=None):
    """Uruchamia polecenie (lista), zwraca (rc, stdout, stderr). Każde wywołanie trafia do commands.log."""
    t0 = time.time()
    try:
        p = subprocess.run(cmd, input=wejscie, capture_output=True, text=True, timeout=timeout, errors='replace',
                           stdin=None if wejscie is not None else subprocess.DEVNULL)
        rc, out, err = p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired as e:
        out = e.stdout if isinstance(e.stdout, str) else ''
        rc, err = 124, 'TIMEOUT'
    except FileNotFoundError:
        rc, out, err = 127, '', f'program not found: {cmd[0]}'
    log(f'[{rc}] ({time.time() - t0:.1f}s) {" ".join(cmd)}\n--- stdout ---\n{out[-20000:]}\n--- stderr ---\n{err[-4000:]}',
        'commands.log')
    return rc, out, err


