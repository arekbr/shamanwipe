KLUCZE_STALE = {'id', 'program', 'operator', 'system', 'model', 'uuid', 'firmware', 'wwn', 'status', 'start', 'rc', 'sstat',
                'name', 'title', 'organization', 'location', 'contact'}
DANE_BEZ_ZMIAN = {'narzedzia', 'podsumowanie'}


def raport_eksport(obj):
    """Kopia raportu ze stałymi kluczami angielskimi (wartości bez zmian)."""
    if isinstance(obj, dict):
        return {KLUCZE_RAPORTU.get(k, k): (v if k in DANE_BEZ_ZMIAN else raport_eksport(v)) for k, v in obj.items()}
    if isinstance(obj, list):
        return [raport_eksport(v) for v in obj]
    return obj


def klucze_spoza_schematu(obj, sciezka=''):
    """Klucze wyeksportowanego raportu spoza schematu (kontrola testów: żaden klucz wewnętrzny nie wycieka)."""
    dozwolone = set(KLUCZE_RAPORTU.values()) | KLUCZE_STALE
    zle = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k not in dozwolone:
                zle.append(f'{sciezka}/{k}')
            if k == 'summary':
                zle += [f'{sciezka}/summary/{s}' for s in v if s not in STATUSY]
            elif k != 'tools':
                zle += klucze_spoza_schematu(v, f'{sciezka}/{k}')
    elif isinstance(obj, list):
        for v in obj:
            zle += klucze_spoza_schematu(v, sciezka)
    return zle


def katalog_raportow():
    if os.path.ismount(MNT_RAPORTY) and os.access(MNT_RAPORTY, os.W_OK):
        return os.path.join(MNT_RAPORTY, 'reports'), True
    return os.path.join(KATALOG_RUN, 'reports'), False


def dict_do_xml(rodzic, klucz, wartosc):
    tag = re.sub(r'[^A-Za-z0-9_]', '_', str(klucz)) or 'pole'
    tag = 'p_' + tag if tag[0].isdigit() else tag
    el = ET.SubElement(rodzic, tag)
    if isinstance(wartosc, dict):
        for k, v in wartosc.items():
            dict_do_xml(el, k, v)
    elif isinstance(wartosc, list):
        for v in wartosc:
            dict_do_xml(el, 'element', v)
    else:
        el.text = '' if wartosc is None else str(wartosc)


