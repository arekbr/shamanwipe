def parsuj_hdparm_I(t):
    """Wynik `hdparm -I`. Zwraca None, gdy to nie jest odpowiedź urządzenia ATA."""
    if not t or 'ATA device' not in t or 'Model Number' not in t:
        return None

    def pole(rx):
        m = re.search(rx, t)
        return m.group(1).strip() if m else ''

    d = {'model': pole(r'Model Number:\s*(.+)'), 'serial': pole(r'Serial Number:\s*(.+)'),
         'firmware': pole(r'Firmware Revision:\s*(.+)'), 'transport': pole(r'Transport:\s*(.+)')}
    lba48 = pole(r'LBA48\s+user addressable sectors:\s*(\d+)')
    lba28 = pole(r'LBA\s+user addressable sectors:\s*(\d+)')
    d['sektory'] = int(lba48 or lba28 or 0)
    d['sektor_logiczny'] = int(pole(r'Logical\s+Sector size:\s*(\d+)') or 512)
    rot = pole(r'Nominal Media Rotation Rate:\s*(.+)')
    if 'Solid State' in rot:
        d['ssd'] = True
    elif rot.isdigit():
        d['ssd'], d['obroty'] = False, int(rot)
    else:
        d['ssd'] = None

    sec = ''
    m = re.search(r'^Security:\s*\n((?:[ \t].*\n?)*)', t, re.M)
    if m:
        sec = m.group(1)

    def flaga(nazwa):
        mm = re.search(r'^\s*(not\s+)?' + nazwa + r'\b', sec, re.M)
        return None if not mm else (mm.group(1) is None)

    bezp = {'obslugiwane': flaga('supported'), 'wlaczone': flaga('enabled'), 'zablokowane': flaga('locked'),
            'zamrozone': flaga('frozen'), 'licznik_wyczerpany': flaga('expired'),
            'enhanced': bool(re.search(r'supported:\s*enhanced erase', sec)), 'czas_min': None, 'czas_enh_min': None}
    mm = re.search(r'(\d+)min for SECURITY ERASE UNIT', sec)
    if mm:
        bezp['czas_min'] = int(mm.group(1))
    mm = re.search(r'(\d+)min for ENHANCED SECURITY ERASE UNIT', sec)
    if mm:
        bezp['czas_enh_min'] = int(mm.group(1))
    d['bezpieczenstwo'] = bezp
    obsl = bool(re.search(r'SANITIZE feature set', t))
    d['sanitize'] = {'obslugiwany': obsl,
                     'crypto': obsl and bool(re.search(r'CRYPTO_SCRAMBLE_EXT command', t)),
                     'block': obsl and bool(re.search(r'BLOCK_ERASE_EXT command', t)),
                     'overwrite': obsl and bool(re.search(r'OVERWRITE_EXT command', t))}
    return d


def parsuj_hdparm_N(t):
    """`hdparm -N`: 'max sectors = 1953525168/1953525168, HPA is disabled'."""
    m = re.search(r'max sectors\s*=\s*(\d+)/(\d+),\s*(?:HPA|accessible max address)[^\n]*?is\s+(enabled|disabled)', t or '')
    if not m:
        return None
    biezace, natywne = int(m.group(1)), int(m.group(2))
    return {'biezace': biezace, 'natywne': natywne, 'hpa_wlaczony': m.group(3) == 'enabled' or biezace < natywne}


def parsuj_dco(t):
    m = re.search(r'Real max sectors:\s*(\d+)', t or '')
    return int(m.group(1)) if m else None


def ocen_sanitize_status(t):
    """`hdparm --sanitize-status` → 'OK' | 'W_TOKU' | 'BLAD' | 'NIEZNANY' (+ postęp %)."""
    t = t or ''
    postep = None
    m = re.search(r'Progress:\s*0x([0-9a-f]+)', t, re.I)
    if m:
        postep = round(int(m.group(1), 16) * 100 / 65535, 1)
    if re.search(r'In Process|SD2', t):
        return 'W_TOKU', postep
    if re.search(r'Completed Without Error', t, re.I):
        return 'OK', 100.0
    if re.search(r'Completed With Error|failed|SD1', t, re.I):
        return 'BLAD', postep
    return 'NIEZNANY', postep


def ocen_po_security_erase(rc, tekst_identify_po, serial_przed):
    """Warunek sukcesu ATA SE: IDENTIFY po, ten sam S/N, Security not enabled / not locked.

    Zwraca (wynik, opis): 'OK' | 'UNCONFIRMED' | 'BLAD'.
    Bywa SSD, który po SE zwraca rc=0, a na IDENTIFY nie odpowiada → UNCONFIRMED, nie sukces.
    """
    if rc != 0:
        return 'BLAD', L(f'polecenie zakończone kodem {rc}', f'command exited with code {rc}')
    a = parsuj_hdparm_I(tekst_identify_po)
    if a is None:
        return 'UNCONFIRMED', L('polecenie zakończone kodem 0, ale dysk nie odpowiada na IDENTIFY — stanu nie da się potwierdzić',
                                'command exited with code 0, but the drive does not answer IDENTIFY — the state cannot be confirmed')
    if serial_przed and a.get('serial') != serial_przed:
        return 'BLAD', L(f'po operacji inny numer seryjny ({a.get("serial")} ≠ {serial_przed})',
                         f'different serial number after the operation ({a.get("serial")} ≠ {serial_przed})')
    b = a['bezpieczenstwo']
    if b.get('wlaczone') or b.get('zablokowane'):
        return 'BLAD', L('po operacji hasło ATA nadal ustawione / dysk zablokowany',
                         'ATA password still set / drive locked after the operation')
    if b.get('wlaczone') is None and b.get('zablokowane') is None:
        return 'UNCONFIRMED', L('IDENTIFY po bez sekcji Security', 'IDENTIFY afterwards has no Security section')
    return 'OK', L('IDENTIFY po: ten sam S/N, Security not enabled, not locked',
                   'IDENTIFY afterwards: same S/N, Security not enabled, not locked')


def parsuj_nvme_id_ctrl(js):
    d = json.loads(js) if isinstance(js, str) else js
    sanicap, fna, oacs = int(d.get('sanicap', 0)), int(d.get('fna', 0)), int(d.get('oacs', 0))
    return {'model': str(d.get('mn', '')).strip(), 'serial': str(d.get('sn', '')).strip(),
            'firmware': str(d.get('fr', '')).strip(),
            'sanitize': {'crypto': bool(sanicap & 1), 'block': bool(sanicap & 2), 'overwrite': bool(sanicap & 4)},
            'format_obslugiwany': bool(oacs & 2), 'format_wszystkie_ns': bool(fna & 1), 'format_crypto': bool(fna & 4),
            'sanicap': sanicap, 'fna': fna, 'oacs': oacs}


def parsuj_nvme_id_ns(js):
    d = json.loads(js) if isinstance(js, str) else js
    flbas = int(d.get('flbas', 0))
    lbaf = (flbas & 0xF) | (((flbas >> 5) & 0x3) << 4)
    lbafs = d.get('lbafs') or []
    ds = int(lbafs[lbaf].get('ds', 9)) if lbaf < len(lbafs) else 9
    nsze = int(d.get('nsze', 0))
    return {'lbaf': lbaf, 'ms': (flbas >> 4) & 1, 'pi': int(d.get('dps', 0)) & 7, 'nsze': nsze,
            'rozmiar_b': nsze * (1 << ds) if nsze else None}


def parsuj_sg_opcodes(t):
    s = {'crypto': False, 'block': False, 'overwrite': False}
    for linia in (t or '').splitlines():
        m = re.search(r'Sanitize,\s*(overwrite|block erase|cryptographic erase)', linia, re.I)
        if m:
            s[{'overwrite': 'overwrite', 'block erase': 'block', 'cryptographic erase': 'crypto'}[m.group(1).lower()]] = True
    return s


def znajdz_klucze(obj, klucze):
    """Pierwsze wystąpienia kluczy w zagnieżdżonym JSON (formaty nvme-cli zmieniają się między wersjami)."""
    wynik = {}

    def _r(o):
        if isinstance(o, dict):
            for k, v in o.items():
                if k in klucze and k not in wynik and not isinstance(v, (dict, list)):
                    wynik[k] = v
                _r(v)
        elif isinstance(o, list):
            for v in o:
                _r(v)
    _r(obj)
    return wynik


def parsuj_smart(js):
    try:
        d = json.loads(js)
    except (ValueError, TypeError):
        return {'dostepny': False}
    s = {'dostepny': True, 'zdrowie': (d.get('smart_status') or {}).get('passed'),
         'godziny_pracy': (d.get('power_on_time') or {}).get('hours'),
         'temperatura': (d.get('temperature') or {}).get('current'),
         'model': d.get('model_name'), 'serial': d.get('serial_number'), 'firmware': d.get('firmware_version'),
         'obroty': d.get('rotation_rate'), 'protokol': (d.get('device') or {}).get('protocol')}
    for a in ((d.get('ata_smart_attributes') or {}).get('table') or []):
        nazwa = {5: 'realokowane', 197: 'oczekujace', 198: 'nienaprawialne'}.get(a.get('id'))
        if nazwa:
            s[nazwa] = (a.get('raw') or {}).get('value')
    nv = d.get('nvme_smart_health_information_log') or {}
    if nv:
        s['zuzycie_proc'] = nv.get('percentage_used')
        s['bledy_nosnika'] = nv.get('media_errors')
    return s


def pogorszenie_smart(przed, po):
    """Lista zastrzeżeń stanu dysku (SMART FAILED, wzrost 5/197/198, błędy nośnika NVMe)."""
    z = []
    if po.get('zdrowie') is False or przed.get('zdrowie') is False:
        z.append(L('SMART: ocena zdrowia FAILED', 'SMART: overall health FAILED'))
    for k, opis in (('realokowane', L('realokowane (5)', 'reallocated (5)')), ('oczekujace', L('oczekujące (197)', 'pending (197)')),
                    ('nienaprawialne', L('nienaprawialne (198)', 'uncorrectable (198)')),
                    ('bledy_nosnika', L('błędy nośnika NVMe', 'NVMe media errors'))):
        a, b = przed.get(k), po.get(k)
        if isinstance(a, int) and isinstance(b, int) and b > a:
            z.append(L(f'SMART: wzrost licznika {opis} {a} → {b}', f'SMART: {opis} counter increased {a} → {b}'))
    if (przed.get('oczekujace') or 0) > 0:
        z.append(L(f'SMART: {przed["oczekujace"]} sektorów oczekujących (197) — dysk ma nieczytelne sektory',
                   f'SMART: {przed["oczekujace"]} pending sectors (197) — the drive has unreadable sectors'))
    return z


