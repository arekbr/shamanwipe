def odcisk_klucza(pub):
    rc, out, _ = uruchom(['sh', '-c', 'openssl pkey -pubin -in "$1" -outform DER | sha256sum', 'sh', pub], timeout=20)
    return out.split()[0] if rc == 0 and out else ''


def pytaj_haslo(zacheta, limit_s=None, przerwij=None):
    """Hasło bez echa. limit_s: czas na wpisanie; przerwij(): sprawdzane co sekundę (AUTOMAT: przerwanie z innej konsoli)."""
    import getpass
    if limit_s is None:
        try:
            return getpass.getpass(zacheta)
        except (EOFError, KeyboardInterrupt):
            return ''
    sys.stdout.write(zacheta + L(f'(limit {limit_s} s) ', f'({limit_s} s limit) '))
    sys.stdout.flush()
    stare = None
    try:
        stare = termios.tcgetattr(sys.stdin)
        nowe = termios.tcgetattr(sys.stdin)
        nowe[3] &= ~termios.ECHO
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, nowe)
    except (termios.error, ValueError):
        stare = None
    try:
        koniec = time.time() + limit_s
        while time.time() < koniec:
            if przerwij and przerwij():
                return ''
            r, _, _ = select.select([sys.stdin], [], [], min(1.0, max(0.0, koniec - time.time())))
            if r:
                return sys.stdin.readline().strip()
        return ''
    finally:
        if stare:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, stare)
        print()


def klucz_podpisuje(priv):
    """Próbny podpis przed kasowaniem: raport dostaje „podpisany” tylko z kluczem, który naprawdę podpisuje."""
    p = os.path.join(KATALOG_RUN, 'test-podpisu')
    with open(p, 'w') as f:
        f.write(teraz_iso())
    rc = uruchom(['openssl', 'pkeyutl', '-sign', '-inkey', priv, '-rawin', '-in', p, '-out', p + '.sig'], timeout=20)[0]
    for x in (p, p + '.sig'):
        with contextlib.suppress(OSError):
            os.remove(x)
    if rc != 0:
        print(L('Klucz podpisu nie podpisuje (próba nieudana) — raporty będą NIEPODPISANE.',
                'The signing key cannot sign (test failed) — reports will be UNSIGNED.'))
    return rc == 0


def przygotuj_klucz(interaktywnie=True, limit_s=None, przerwij=None):
    """(klucz prywatny w /run, klucz publiczny) albo (None, None). Hasło idzie wyłącznie stdin-em do openssl."""
    kat = os.path.join(MNT_RAPORTY, 'key')
    priv, pub = os.path.join(kat, 'shamanwipe-signing.pem'), os.path.join(kat, 'shamanwipe-signing.pub.pem')
    if not (os.path.exists(priv) and os.path.exists(pub)):
        return None, None
    cel = os.path.join(KATALOG_RUN, 'klucz.pem')
    os.makedirs(KATALOG_RUN, exist_ok=True)
    stara = os.umask(0o077)
    try:
        if uruchom(['openssl', 'pkey', '-in', priv, '-passin', 'pass:', '-out', cel], timeout=20)[0] == 0:
            return (cel, pub) if klucz_podpisuje(cel) else (None, None)
        if not interaktywnie or not sys.stdin.isatty():
            return None, None
        haslo = pytaj_haslo(L('Hasło klucza podpisu raportów (Enter = bez podpisu): ',
                              'Report signing key passphrase (Enter = no signature): '), limit_s, przerwij)
        if not haslo:
            return None, None
        if uruchom(['openssl', 'pkey', '-in', priv, '-passin', 'stdin', '-out', cel], timeout=20, wejscie=haslo + '\n')[0] == 0:
            return (cel, pub) if klucz_podpisuje(cel) else (None, None)
        print(L('Złe hasło — raporty będą NIEPODPISANE.', 'Wrong passphrase — reports will be UNSIGNED.'))
        return None, None
    finally:
        os.umask(stara)


def manifest(kat):
    linie = []
    for korz, _, pliki in os.walk(kat):
        for p in pliki:
            wzgl = os.path.relpath(os.path.join(korz, p), kat)
            if wzgl in ('MANIFEST.sha256', 'MANIFEST.sha256.sig'):
                continue
            with open(os.path.join(korz, p), 'rb') as f:
                linie.append((wzgl, hashlib.sha256(f.read()).hexdigest()))
    with open(os.path.join(kat, 'MANIFEST.sha256'), 'w') as f:
        f.write(''.join(f'{h}  {n}\n' for n, h in sorted(linie)))


def zapisz_raport(zadania, operator, numer_srodka, profil, tryb, t_start, klucz, inwentarz_dyski=None, nic=None):
    system = dane_systemu()
    baza, na_pendrive = katalog_raportow()
    rdzen = f'{teraz().strftime("%Y%m%d-%H%M%S")}_{re.sub(r"[^A-Za-z0-9-]", "", system["numer_seryjny"] or system["uuid"] or "computer")[:32]}'
    ident, n = rdzen, 1
    os.makedirs(baza, exist_ok=True)
    while True:  # mkdir atomowy: dwa raporty w tej samej sekundzie dostają różne katalogi
        try:
            os.mkdir(os.path.join(baza, ident))
            break
        except FileExistsError:
            n += 1
            ident = f'{rdzen}-{n}'
    kat = os.path.join(baza, ident)
    os.makedirs(os.path.join(kat, 'smart'))
    dyski = [wiersz_dysku(z) for z in zadania]
    for z in zadania:
        for etap in ('przed', 'po'):
            surowy = z.d.get(f'smart_{etap}_surowy')
            if surowy:
                with open(os.path.join(kat, 'smart', f'{z.d["nazwa"]}-{etap}.json'), 'w') as f:
                    f.write(surowy)
    wykonane = {x['urzadzenie'] for x in dyski}
    raport = {'id': ident, 'utworzono': teraz_iso(), 'rozpoczeto': t_start, 'program': f'shamanwipe {WERSJA}', 'jezyk': JEZYK, 'tryb': tryb,
              'profil': profil, 'opis_profilu': PROFILE.get(profil, ''), 'operator': operator, 'numer_srodka': numer_srodka,
              'system': system, 'dyski': dyski, 'nic_nie_skasowano': nic,
              'podsumowanie': {s: sum(1 for d in dyski if d['status'] == s) for s in STATUSY},
              'pominiete': [{'urzadzenie': d['sciezka'], 'model': d.get('model'), 'numer_seryjny': d.get('serial'),
                             'powod': '; '.join(d.get('chroniony') or d.get('plan', {}).get('uwagi', [])) or L('nie wybrany', 'not selected')}
                            for d in (inwentarz_dyski or []) if d['sciezka'] not in wykonane],
              'podpis': {'podpisany': False, 'odcisk_klucza': '', 'stan': 'NONE'}}
    if klucz[0]:
        raport['podpis'] = {'podpisany': True, 'odcisk_klucza': odcisk_klucza(klucz[1]), 'stan': 'Ed25519 over MANIFEST.sha256'}
    eksport = raport_eksport(raport)
    with open(os.path.join(kat, 'report.json'), 'w', encoding='utf-8') as f:
        json.dump(eksport, f, ensure_ascii=False, indent=2)
    with open(os.path.join(kat, 'report.csv'), 'w', encoding='utf-8-sig', newline='') as f:
        w = csv.writer(f, delimiter=';')
        w.writerow(['report', 'computer_serial', 'device', 'model', 'serial_number', 'size_bytes', 'media_type', 'nist_method',
                    'technique', 'verification', 'bytes_verified', 'status', 'warnings', 'start', 'end', 'operator', 'signature'])
        for d in dyski:
            w.writerow([ident, system['numer_seryjny'], d['urzadzenie'], d['model'], d['numer_seryjny'], d['rozmiar_urzadzenia_b'],
                        d['typ_nosnika'], d['metoda_nist'], d['technika'], (d['weryfikacja'] or {}).get('metoda', ''),
                        d['zweryfikowane_b'], d['status'], ' | '.join(d['zastrzezenia'] + d['niepotwierdzone']), d['start'],
                        d['koniec'], operator.get('name', ''), raport['podpis']['stan']])
    korzen = ET.Element('sanitization_report')
    for k, v in eksport.items():
        dict_do_xml(korzen, k, v)
    ET.ElementTree(korzen).write(os.path.join(kat, 'report.xml'), encoding='utf-8', xml_declaration=True)
    try:
        pisz_pdf(os.path.join(kat, 'report.pdf'), raport)
    except Exception as e:  # noqa: BLE001 — brak PDF nie może zgubić JSON/CSV/XML
        log(f'PDF: error {e}')
    for plik in ('run.log', 'commands.log'):
        zr = os.path.join(KATALOG_RUN, plik)
        if os.path.exists(zr):
            shutil.copy(zr, os.path.join(kat, plik))
    if klucz[0]:
        shutil.copy(klucz[1], os.path.join(kat, 'public-key.pem'))
    manifest(kat)
    if klucz[0]:
        rc, _, err = uruchom(['openssl', 'pkeyutl', '-sign', '-inkey', klucz[0], '-rawin', '-in', os.path.join(kat, 'MANIFEST.sha256'),
                              '-out', os.path.join(kat, 'MANIFEST.sha256.sig')], timeout=30)
        if rc != 0:
            log(f'signature: error {err}')
    os.sync()
    return kat, na_pendrive


def weryfikuj_raport(kat, pub=None):
    """0 = sumy i podpis OK (VALID); 1 = sumy OK, raport niepodpisany; 2 = NIEWAŻNY (INVALID)."""
    mf = os.path.join(kat, 'MANIFEST.sha256')
    niewazny = L('NIEWAŻNY: ', 'INVALID: ')
    if not os.path.exists(mf):
        print(niewazny + L('brak MANIFEST.sha256', 'MANIFEST.sha256 missing'))
        return 2
    wpisane, zle = {}, []
    for linia in open(mf, encoding='utf-8', errors='replace').read().splitlines():
        if '  ' not in linia:
            zle.append(L('uszkodzony wiersz manifestu', 'damaged manifest line'))
            continue
        h, nazwa = linia.split('  ', 1)
        wpisane[nazwa] = h
    for nazwa, h in wpisane.items():
        sc = os.path.join(kat, nazwa)
        if not os.path.exists(sc):
            zle.append(L(f'brak pliku {nazwa}', f'missing file {nazwa}'))
            continue
        with open(sc, 'rb') as f:
            if hashlib.sha256(f.read()).hexdigest() != h:
                zle.append(L(f'zmieniony plik {nazwa}', f'modified file {nazwa}'))
    for korz, _, pliki in os.walk(kat):
        for p in pliki:
            wzgl = os.path.relpath(os.path.join(korz, p), kat)
            if wzgl not in wpisane and wzgl not in ('MANIFEST.sha256', 'MANIFEST.sha256.sig'):
                zle.append(L(f'plik spoza manifestu {wzgl}', f'file not in the manifest {wzgl}'))
    if zle:
        print(niewazny + '; '.join(zle))
        return 2
    sig = os.path.join(kat, 'MANIFEST.sha256.sig')
    pub = pub or os.path.join(kat, 'public-key.pem')
    if not os.path.exists(sig):
        print(L(f'Sumy SHA-256 zgodne ({len(wpisane)} plików), raport NIEPODPISANY.',
                f'SHA-256 sums match ({len(wpisane)} files), report is UNSIGNED.'))
        return 1
    rc, out, err = uruchom(['openssl', 'pkeyutl', '-verify', '-pubin', '-inkey', pub, '-rawin', '-in', mf, '-sigfile', sig], timeout=30)
    if rc != 0:
        print(niewazny + L('podpis nie zgadza się z manifestem albo kluczem', 'the signature does not match the manifest or the key'))
        return 2
    print(L(f'WAŻNY: sumy zgodne ({len(wpisane)} plików), podpis Ed25519 poprawny, odcisk klucza {odcisk_klucza(pub)}',
            f'VALID: sums match ({len(wpisane)} files), Ed25519 signature correct, key fingerprint {odcisk_klucza(pub)}'))
    return 0


