    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(dict(dane, faza=faza, czas=time.time(), id=_PRZEBIEG.get('id'), pid=os.getpid(), konsola=konsola()),
                  f, ensure_ascii=False)
    os.replace(tmp, PLIK_AUTOMAT)


def czekaj_z_przerwaniem(sekundy):
    """Odliczanie AUTOMATU. Przerywa dowolny klawisz na tej konsoli (także Ctrl+C) albo żądanie z podglądu na innej.
    True = odliczono do końca bez przerwania."""
    try:
        with SurowyTerminal():
            for i in range(sekundy, 0, -1):
                if przerwanie_zgloszone():
                    print()
                    return False
                sys.stdout.write(L(f'\r  start za {i:3d} s — DOWOLNY KLAWISZ (na każdej konsoli) przerywa ',
                                   f'\r  starting in {i:3d} s — ANY KEY (on any console) aborts '))
                sys.stdout.flush()
                if klawisz(1):
                    print()
                    return False
    except KeyboardInterrupt:
        return False
    print()
    return not przerwanie_zgloszone()


def automat_przerwany(cele):
    faza_automatu('przerwany', cele=cele)
    print(L('\nPRZERWANE — nic nie zostało skasowane.', '\nABORTED — nothing was erased.'), flush=True)
    return 6


def tryb_automat(param):
    profil = ALIASY_PROFILI.get(param.get('auto', 'standard'), param.get('auto', 'standard'))
    profil = profil if profil in PROFILE else 'standard'
    _PRZEBIEG.clear()
    _PRZEBIEG['id'] = f'{int(time.time() * 1000)}-{os.getpid()}'
    print(L(f'\n*** ShamanWipe {WERSJA} — AUTOMAT, profil: {profil} ***  (dowolny klawisz przerywa)',
            f'\n*** ShamanWipe {WERSJA} — AUTO, profile: {profil} ***  (any key aborts)'), flush=True)
    faza_automatu('badanie')
    cele = []
    with SurowyTerminal():  # klawisz naciśnięty w trakcie badania = przerwanie (sprawdzane przed pytaniem o hasło)
        if not raporty_zapisywalne():
            faza_automatu('odmowa')
            print(L('ODMOWA: AUTOMAT wymaga zapisywalnej partycji SW-REPORTS (zapis + fsync + odczyt próbny nie powiódł się). Nic nie skasowano.',
                    'REFUSED: AUTO requires a writable SW-REPORTS partition (test write + fsync + read failed). Nothing was erased.'))
            return 5
        print(L('Badam dyski…', 'Scanning disks…'))
        dyski = inwentarz()
        if not inwentarz.nosnik_jednoznaczny:
            faza_automatu('odmowa')
            print(L('ODMOWA: nie umiem jednoznacznie wskazać nośnika startowego (/run/live/medium ani etykieta SHAMANWIPE). Nic nie skasowano.',
                    'REFUSED: cannot unambiguously identify the boot medium (neither /run/live/medium nor the SHAMANWIPE label). '
                    'Nothing was erased.'))
            return 5
        plan_dla_wszystkich(dyski, profil, automat=True)
        print(tabela_dyskow(dyski))
        lista = [d for d in dyski if d.get('plan', {}).get('mozliwe')]
        if not lista:
            powod = L('brak dysków do skasowania', 'no disks to erase')
            rc, lspci, _ = uruchom(['lspci'], timeout=20)
            if re.search(r'RAID bus controller|Volume Management Device', lspci):
                powod += L(' — wykryto kontroler RAID/Intel VMD: dyski mogą być ukryte; w BIOS przełącz SATA na AHCI / wyłącz VMD',
                           ' — RAID/Intel VMD controller detected: disks may be hidden; in the BIOS switch SATA to AHCI / disable VMD')
            print(L(f'\n{powod.upper()}. Zapisuję raport „NIC NIE SKASOWANO”.', f'\n{powod.upper()}. Writing a "NOTHING ERASED" report.'))
            kat, na = zapisz_raport([], czytaj_operatora(), '', profil, 'auto', teraz_iso(), (None, None), dyski, nic=powod)
            faza_automatu('koniec')
            print(L('Raport: ', 'Report: ') + f'{kat}\nSHAMANWIPE AUTO DONE NOTHING_ERASED')
            return 0
        cele = [f'{d["sciezka"]}  {d.get("model")}  S/N {d.get("serial")}  {czytelny_rozmiar(d["rozmiar_b"])}  → {d["plan"]["klasa"]}: {d["plan"]["technika"]}'
                for d in lista]
        nacisniety = klawisz(0)
    if nacisniety or przerwanie_zgloszone():
        return automat_przerwany(cele)
    faza_automatu('hasło', cele=cele)
    klucz = przygotuj_klucz(interaktywnie=True, limit_s=60, przerwij=przerwanie_zgloszone)
    print(L(f'\nZa {ODLICZANIE_AUTOMAT_S} s zacznę NIEODWRACALNIE kasować {len(lista)} dysk(ów):',
            f'\nIn {ODLICZANIE_AUTOMAT_S} s I will IRREVERSIBLY erase {len(lista)} disk(s):'))
    for c in cele:
        print(f'   {c}')
    faza_automatu('odliczanie', cele=cele, koniec=time.time() + ODLICZANIE_AUTOMAT_S)
    odliczone = czekaj_z_przerwaniem(ODLICZANIE_AUTOMAT_S)
    if odliczone:
        faza_automatu('kasowanie', cele=cele)
        # Ostatnia kontrola PO zapisie fazy: żądanie złożone przed tą linią przerywa; później podgląd widzi „kasowanie”
        odliczone = not przerwanie_zgloszone()
    if not odliczone:
        return automat_przerwany(cele)
    zadania, t0 = kasuj(lista, profil)
    kat, na = zapisz_raport(zadania, czytaj_operatora(), '', profil, 'auto', t0, klucz, dyski)
    wyniki = ' '.join(f'{z.d["nazwa"]}={z.status}' for z in zadania)
    faza_automatu('koniec', cele=cele, wyniki=wyniki, raport=kat)
    ekran_koncowy(kat, na, zadania, klucz)
    print('SHAMANWIPE AUTO DONE ' + wyniki)  # wiersz maszynowy (stały, po angielsku)
    if param.get('after') == 'poweroff':
        print(L('Wyłączam komputer za 15 s…', 'Powering off in 15 s…'))
        time.sleep(15)
        subprocess.run(['systemctl', 'poweroff'])
    return 0


def podglad(automat=False):
    """Konsola bez blokady: podgląd przebiegu z innej konsoli.
    Ręcznie: Ctrl+C albo koniec cudzej operacji wraca. AUTOMAT: KAŻDY klawisz to żądanie przerwania, które trwa, aż trafi
    do bieżącego przebiegu (id + PID właściciela blokady); werdykt pokazuje WYŁĄCZNIE faza zapisana przez właściciela;
    wyjście dopiero po końcu AUTOMATU albo zniknięciu jego procesu."""
    plik_stanu = os.path.join(KATALOG_RUN, 'stan.json')
    print(L('Operacja na dyskach trwa na innej konsoli. Podgląd przebiegu — ', 'A disk operation is running on another console. '
            'Progress view — ') + (L('DOWOLNY KLAWISZ PRZERYWA AUTOMAT przed kasowaniem.', 'ANY KEY ABORTS AUTO before erasure.')
                                   if automat else L('Ctrl+C: powrót.', 'Ctrl+C: back.')), flush=True)
    chce, dostarczone, komunikat, bez_wlasciciela = False, set(), '', None
    try:
        with (SurowyTerminal() if automat else contextlib.nullcontext()):
            while True:
                wl = wlasciciel_blokady()
                a = wczytaj_json(PLIK_AUTOMAT) if automat else None
                biezacy = bool(a and wl and a.get('pid') == wl)
                if automat and chce:
                    if biezacy and a.get('faza') not in FAZY_BEZ_PRZERWANIA and a.get('id') not in dostarczone:
                        open(plik_przerwania(a['id']), 'w').close()
                        dostarczone.add(a['id'])
                    f = a.get('faza') if a else None
                    if a and a.get('id') in dostarczone:
                        za_pozno = L('ZA PÓŹNO — kasowanie ruszyło, zanim żądanie dotarło.',
                                     'TOO LATE — erasure started before the request arrived.')
                        komunikat = {'przerwany': L('PRZERWANO — potwierdzone przez konsolę AUTOMATU. Nic nie skasowano.',
                                                    'ABORTED — confirmed by the AUTO console. Nothing was erased.'),
                                     'kasowanie': za_pozno, 'koniec': za_pozno}.get(
                            f, L('ŻĄDANIE PRZERWANIA WYSŁANE — czekam na potwierdzenie konsoli AUTOMATU…',
                                 'ABORT REQUEST SENT — waiting for confirmation from the AUTO console…'))
                    elif biezacy and f in FAZY_BEZ_PRZERWANIA:
                        komunikat = L('ZA PÓŹNO — kasowanie już trwa (przerwanie działa tylko przed kasowaniem).',
                                      'TOO LATE — erasure is already running (abort works only before erasure).')
                    else:
                        komunikat = L('ŻĄDANIE PRZERWANIA ZAPAMIĘTANE — trafi do AUTOMATU, zanim zacznie kasować.',
                                      'ABORT REQUEST STORED — it will reach AUTO before erasure starts.')
                ekran = (komunikat + '\n\n') if komunikat else ''
                if a:
                    f = a.get('faza')
                    if f == 'odliczanie':
                        ekran += L(f"AUTOMAT ({a.get('konsola')}): kasowanie za {max(0, int(a.get('koniec', 0) - time.time()))} s\n",
                                   f"AUTO ({a.get('konsola')}): erasure in {max(0, int(a.get('koniec', 0) - time.time()))} s\n")
                    else:
                        ekran += L(f"AUTOMAT ({a.get('konsola')}): faza {kod(f)}\n", f"AUTO ({a.get('konsola')}): phase {kod(f)}\n")
                    ekran += ''.join(f'   {c}\n' for c in a.get('cele', []))
                    if a.get('wyniki'):
                        ekran += L('Wyniki: ', 'Results: ') + f"{a['wyniki']}\n" + L('Raport: ', 'Report: ') + f"{a.get('raport')}\n"
                stan = wczytaj_json(plik_stanu) if wl else None
                if stan:
                    ekran += json.dumps(stan, ensure_ascii=False, indent=1) + '\n'
                sys.stdout.write('\033[2J\033[H' + (ekran or L('Czekam na stan operacji…\n', 'Waiting for the operation state…\n')))
                sys.stdout.flush()
                # wyjście: operacja innej konsoli skończona albo jej proces zniknął
                if wl is None:
                    bez_wlasciciela = bez_wlasciciela or time.time()
                    if not automat:
                        return 0
                    if a and (a.get('faza') in FAZY_KONCOWE or not proces_zyje(a.get('pid'))):
                        if a.get('faza') not in FAZY_KONCOWE:
                            print(L(f"\nPROCES AUTOMATU (PID {a.get('pid')}) ZNIKNĄŁ w fazie „{kod(a.get('faza'))}”",
                                    f"\nTHE AUTO PROCESS (PID {a.get('pid')}) DISAPPEARED in phase \"{kod(a.get('faza'))}\"")
                                  + (L(' — kasowanie mogło zostać przerwane w trakcie; sprawdź dziennik operacji.',
                                       ' — erasure may have been interrupted midway; check the operations log.') if a.get('faza') == 'kasowanie'
                                     else L(' — nic nie skasowano.', ' — nothing was erased.')))
                        return 0
                    if time.time() - bez_wlasciciela > 15:
                        print(L('\nAUTOMAT nie wystartował na żadnej konsoli — uruchom go ponownie poleceniem shamanwipe.',
                                '\nAUTO did not start on any console — run it again with the shamanwipe command.'))
                        return 0
                else:
                    bez_wlasciciela = None
                if automat:
                    if klawisz(1):
                        chce = True
                elif sys.stdin.isatty():
                    r, _, _ = select.select([sys.stdin], [], [], 2)
                    if r and not sys.stdin.readline():
                        time.sleep(2)
                else:
                    time.sleep(2)
    except KeyboardInterrupt:  # tylko tryb ręczny — w AUTOMACIE Ctrl+C jest zwykłym klawiszem (ISIG wyłączony)
        return 0


def start_automat(param):
    pref = '/dev/' + param.get('console', 'tty1')
    if konsola() != pref:
        # Konsola niepreferowana nie ściga się o AUTOMAT: czeka, aż przejmie go instancja na konsoli preferowanej
        # (tam trafia pytanie o hasło). Sama przejmuje tylko, gdy tamtej nie ma przez PRZEJECIE_AUTOMATU_S s i AUTOMAT
        # w tym rozruchu jeszcze nie ruszył (przerwany AUTOMAT nie może ruszyć ponownie na innej konsoli).
        t0 = time.time()
        while wlasciciel_blokady() is None and not os.path.exists(PLIK_AUTOMAT):
            if instancja_zyje(pref):
                t0 = time.time()
            elif time.time() - t0 >= PRZEJECIE_AUTOMATU_S:
                break
            time.sleep(0.5)
        if wlasciciel_blokady() is not None or os.path.exists(PLIK_AUTOMAT):
            return podglad(automat=True)
        print(L(f'Brak programu na konsoli {pref} — AUTOMAT rusza na tej konsoli ({konsola()}).',
                f'No program on console {pref} — AUTO starts on this console ({konsola()}).'))
    blokada = zajmij_blokade()
    if blokada is None:
        return podglad(automat=True)
    try:
        return tryb_automat(param)
    finally:
        blokada.close()


def start(args):
    os.makedirs(KATALOG_RUN, exist_ok=True)
    param = parametry_jadra()
    zapisz_instancje()
    raporty = zamontuj_raporty()
    rozruch = 'UEFI' if os.path.isdir('/sys/firmware/efi') else 'BIOS'
    # Baner na KAŻDEJ konsoli, przed jakąkolwiek blokadą; BOOT= to znacznik maszynowy (stały, testy rozruchu)
    print(f'SHAMANWIPE {WERSJA} ' + L('GOTOWY', 'READY') + f' · BOOT={rozruch} · ' + L('raporty: ', 'reports: ') +
          (f'{MNT_RAPORTY} (SW-REPORTS)' if raporty else L('BRAK partycji SW-REPORTS — tylko RAM', 'NO SW-REPORTS partition — RAM only')),
          flush=True)
    log(f'start, console {konsola()}, parameters: {param}, SW-REPORTS: {raporty}, boot {rozruch}, language {JEZYK}')
    for w in niedokonczone_operacje():
        print(L(f'!!! NIEDOKOŃCZONA OPERACJA z {w.get("time")}: ', f'!!! UNFINISHED OPERATION from {w.get("time")}: ')
              + f'{w.get("device")} S/N {w.get("serial")} — {w.get("technique")}'
              + (L(f'. Hasło ATA mogło zostać ustawione: hdparm --user-master u --security-disable {ATA_HASLO} <dysk>',
                   f'. The ATA password may have been set: hdparm --user-master u --security-disable {ATA_HASLO} <disk>')
                 if w.get('ata_password_set') else ''))
    try:
        if 'auto' in param:
            return start_automat(param)
        if param.get('mode') == 'inventory':
            z_blokada(lambda: tryb_inwentarz(param, interaktywnie=sys.stdin.isatty()))
        elif sys.stdin.isatty():
            tryb_reczny(param)
        return 0
    finally:
        wl = wlasciciel_blokady()
        if wl and wl != os.getpid():
            print(L(f'\nUWAGA: na innej konsoli nadal trwa operacja na dyskach (PID {wl}) — NIE wyłączaj komputera.',
                    f'\nWARNING: a disk operation is still running on another console (PID {wl}) — do NOT power off.'))


def usb_bot(args):
    """Przełącza mostek USB z UAS na BOT (usb-storage quirks 'u') — dla mostków blokujących ATA w UAS (np. VIA VL711)."""
    for d in inwentarz(szczegolowo=False):
        if d.get('transport') != 'usb' or (args.urzadzenie not in (None, d['nazwa'])):
            continue
        rc, out, _ = uruchom(['udevadm', 'info', '-q', 'property', '-n', d['sciezka']], timeout=10)
        p = dict(l.split('=', 1) for l in out.splitlines() if '=' in l)
        vid, pid = p.get('ID_VENDOR_ID'), p.get('ID_MODEL_ID')
        if vid and pid:
            q = f'{vid}:{pid}:u'
            stare = czytaj('/sys/module/usb_storage/parameters/quirks')
            with open('/sys/module/usb_storage/parameters/quirks', 'w') as f:
                f.write(','.join([x for x in stare.split(',') if x] + [q]))
            print(L(f'{d["nazwa"]}: quirks {q}. ODŁĄCZ i PODŁĄCZ mostek, potem uruchom program jeszcze raz.',
                    f'{d["nazwa"]}: quirks {q}. UNPLUG and REPLUG the bridge, then run the program again.'))
    return 0


def main():
    # Polecenia i opcje po angielsku; polskie nazwy działają jako aliasy (lista, kasuj, weryfikuj, --dysk…)
    profile = list(PROFILE) + list(ALIASY_PROFILI)
    ap = argparse.ArgumentParser(prog='shamanwipe', description=L('Bezpieczne kasowanie dysków (NIST SP 800-88r2 Clear/Purge)',
                                                                  'Secure disk erasure (NIST SP 800-88r2 Clear/Purge)'))
    sub = ap.add_subparsers(dest='polecenie')
    sub.add_parser('start', help=L('start z konsoli (menu / AUTOMAT wg parametrów jądra sw.*)',
                                   'start from the console (menu / AUTO according to the sw.* kernel parameters)'))
    pl = sub.add_parser('list', aliases=['lista'], help=L('inwentarz dysków z proponowaną metodą (tylko odczyt)',
                                                          'disk inventory with the proposed method (read-only)'))
    pl.add_argument('--json', action='store_true', help=L('wewnętrzny zrzut inwentarza (format niestały)',
                                                          'internal inventory dump (format not stable)'))
    pl.add_argument('--profile', '--profil', dest='profil', default='standard', choices=profile)
    pk = sub.add_parser('erase', aliases=['kasuj'], help=L('kasowanie bez menu (wymaga --confirm "KASUJ N")',
                                                           'erase without the menu (requires --confirm "ERASE N")'))
    pk.add_argument('--disk', '--dysk', dest='dysk', action='append', required=True, metavar='DISK')
    pk.add_argument('--profile', '--profil', dest='profil', default='standard', choices=profile)
    pk.add_argument('--confirm', '--potwierdzam', dest='potwierdzam', required=True, metavar='TEXT',
                    help=L('dokładnie: "KASUJ <liczba dysków>" (albo "ERASE <liczba>")', 'exactly: "ERASE <number of disks>" (or "KASUJ <n>")'))
    pk.add_argument('--asset-number', '--numer-srodka', dest='numer_srodka', default='', metavar='ASSET_NUMBER')
    pw = sub.add_parser('verify', aliases=['weryfikuj'], help=L('sprawdza sumy i podpis raportu', 'checks report checksums and signature'))
    pw.add_argument('katalog', metavar='directory')
    pw.add_argument('--key', '--klucz', dest='klucz', default=None, metavar='KEY')
    pu = sub.add_parser('usb-bot', help=L('mostek USB: tryb BOT zamiast UAS (dla poleceń ATA)', 'USB bridge: BOT instead of UAS (for ATA commands)'))
    pu.add_argument('urzadzenie', nargs='?', metavar='device')
    a = ap.parse_args()
    polecenie = {'lista': 'list', 'kasuj': 'erase', 'weryfikuj': 'verify'}.get(a.polecenie, a.polecenie)
    if getattr(a, 'profil', None):
        a.profil = ALIASY_PROFILI.get(a.profil, a.profil)

    if polecenie in (None, 'start'):
        return start(a)
    if polecenie == 'verify':
        return weryfikuj_raport(a.katalog, a.klucz)
    if os.geteuid() != 0:
        print(L('Wymagane uprawnienia root.', 'Root privileges required.'))
        return 9
    if polecenie == 'usb-bot':
        return usb_bot(a)
    zamontuj_raporty()
    blokada = zajmij_blokade()  # list i erase wysyłają polecenia do dysków — nie w trakcie cudzej operacji; zwalnia koniec procesu
    if blokada is None:
        print(L('ODMOWA: na innej konsoli trwa operacja na dyskach (kasowanie/inwentarz). Nic nie zrobiono.',
                'REFUSED: a disk operation (erase/inventory) is running on another console. Nothing was done.'))
        return 3
    dyski = inwentarz()
    if polecenie == 'list':
        plan_dla_wszystkich(dyski, a.profil, [d['sciezka'] for d in dyski])
        if a.json:
            print(json.dumps([{k: v for k, v in d.items() if not k.endswith('_surowy')} for d in dyski], ensure_ascii=False, indent=1))
        else:
            print(tabela_dyskow(dyski))
        return 0
    if polecenie == 'erase':
        mapa = {d['sciezka']: d for d in dyski}
        mapa.update({'/dev/' + d['nazwa']: d for d in dyski})
        bledy = [L(f'{x}: nie ma takiego dysku', f'{x}: no such disk') for x in a.dysk if x not in mapa]
        bledy += [f'{x}: ' + L('CHRONIONY — ', 'PROTECTED — ') + '; '.join(mapa[x]['chroniony'])
                  for x in a.dysk if x in mapa and mapa[x].get('chroniony')]
        if bledy:
            print(L('ODMOWA, nic nie skasowano:\n  ', 'REFUSED, nothing was erased:\n  ') + '\n  '.join(bledy))
            return 3
        if not potwierdzenie_poprawne(a.potwierdzam, len(a.dysk)):
            print(L(f'ODMOWA: wymagane --confirm "KASUJ {len(a.dysk)}"', f'REFUSED: --confirm "ERASE {len(a.dysk)}" required'))
            return 3
        lista = plan_dla_wszystkich(dyski, a.profil, [mapa[x]['sciezka'] for x in a.dysk])
        niem = [d for d in lista if not d['plan']['mozliwe']]
        if niem:
            print(L('ODMOWA: ', 'REFUSED: ') + '; '.join(f"{d['nazwa']}: {' '.join(d['plan']['uwagi'])}" for d in niem))
            return 3
        if _env_test('SW_TEST_PODMIANA'):  # tylko testy podmiany dysku i blokady: pauza między planem a wykonaniem
            print('SWAP: waiting', flush=True)
            while not os.path.exists(_env_test('SW_TEST_PODMIANA')):
                time.sleep(0.2)
        klucz = przygotuj_klucz(interaktywnie=sys.stdin.isatty())
        zadania, t0 = kasuj(lista, a.profil)
        kat, na = zapisz_raport(zadania, czytaj_operatora(), a.numer_srodka, a.profil, 'command', t0, klucz, dyski)
        ekran_koncowy(kat, na, zadania, klucz)
        return 0 if all(z.status in ('ERASED', 'ERASED_WITH_WARNINGS') for z in zadania) else 4
    return 1


if __name__ == '__main__':
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main())
