def zamontuj_raporty():
    os.makedirs(KATALOG_RUN, exist_ok=True)
    with open(os.path.join(KATALOG_RUN, 'montowanie'), 'a') as f:
        # dwie konsole startują naraz, a drugi mount vfat w tym samym miejscu nakłada się; limit, gdy mount zawiśnie
        for _ in range(120):
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                time.sleep(0.5)
        else:
            return os.path.ismount(MNT_RAPORTY)
        if os.path.ismount(MNT_RAPORTY):
            return True
        rc, out, _ = uruchom(['blkid', '-L', ETYKIETA_RAPORTOW], timeout=20)
        if rc != 0 or not out.strip():
            return False
        os.makedirs(MNT_RAPORTY, exist_ok=True)
        uruchom(['mount', '-o', 'rw,noatime,sync', out.strip().splitlines()[0], MNT_RAPORTY], timeout=30)
        return os.path.ismount(MNT_RAPORTY)


def raporty_zapisywalne():
    """Zapis + fsync + odczyt próbny na SW-REPORTS (warunek startu AUTOMATU)."""
    if not os.path.ismount(MNT_RAPORTY):
        return False
    p = os.path.join(MNT_RAPORTY, '.sw-write-test')
    tresc = f'{teraz_iso()} {os.getpid()}'
    try:
        with open(p, 'w') as f:
            f.write(tresc)
            f.flush()
            os.fsync(f.fileno())
        ok = open(p).read() == tresc
        os.remove(p)
        return ok
    except OSError:
        return False


