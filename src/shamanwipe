class SurowyTerminal:
    """Każdy klawisz (także Ctrl+C, Esc, spacja) jako bajt: tryb bez ICANON/ECHO/ISIG; przywracany przy wyjściu."""

    def __enter__(self):
        self.stare = None
        try:
            if sys.stdin.isatty():
                fd = sys.stdin.fileno()
                self.stare = termios.tcgetattr(fd)
                nowe = termios.tcgetattr(fd)
                nowe[3] &= ~(termios.ICANON | termios.ECHO | termios.ISIG)
                nowe[6][termios.VMIN], nowe[6][termios.VTIME] = 1, 0
                termios.tcsetattr(fd, termios.TCSANOW, nowe)
        except (termios.error, ValueError):
            self.stare = None
        return self

    def __exit__(self, *_):
        if self.stare:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSANOW, self.stare)


def klawisz(limit):
    """Czeka do `limit` s na dowolny bajt z konsoli i zjada wszystkie czekające. True = naciśnięto. EOF to nie klawisz."""
    if not sys.stdin.isatty():
        time.sleep(limit)
        return False
    r, _, _ = select.select([sys.stdin.fileno()], [], [], limit)
    if not r:
        return False
    try:
        dane = os.read(sys.stdin.fileno(), 4096)
    except OSError:
        dane = b''
    if not dane:
        time.sleep(limit)
        return False
    return True


