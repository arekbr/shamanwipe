# Dziennik operacji (przed każdym poleceniem niszczącym; po starcie widać niedokończone)
# ---------------------------------------------------------------------------------------------
def plik_dziennika():
    if os.path.ismount(MNT_RAPORTY) and os.access(MNT_RAPORTY, os.W_OK):
        return os.path.join(MNT_RAPORTY, 'operations-log.jsonl')
    return os.path.join(KATALOG_RUN, 'operations-log.jsonl')


def boot_id():
    return czytaj('/proc/sys/kernel/random/boot_id')


def proces_zyje(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True


def dziennik(wpis):
    # Klucze dziennika (operations-log.jsonl) są stałe i angielskie, jak schemat raportu
    wpis = dict(wpis, time=teraz_iso(), program=WERSJA, boot_id=boot_id(), pid=os.getpid())
    try:
        with open(plik_dziennika(), 'a', encoding='utf-8') as f:
            f.write(json.dumps(wpis, ensure_ascii=False) + '\n')
            f.flush()
            os.fsync(f.fileno())
    except OSError as e:
        log(f'operations log: write error {e}')


def niedokonczone_operacje():
    otwarte = {}
    try:
        for linia in open(plik_dziennika(), encoding='utf-8'):
            try:
                w = json.loads(linia)
            except ValueError:
                continue
            if w.get('state') == 'start':
                otwarte[w['id']] = w
            elif w.get('state') == 'end':
                otwarte.pop(w.get('id'), None)
    except OSError:
        return []
    # Operacja z TEGO rozruchu, której proces żyje, jest W TOKU (np. na drugiej konsoli), nie „niedokończona”
    biez = boot_id()
    return [w for w in otwarte.values() if not (biez and w.get('boot_id') == biez and proces_zyje(w.get('pid')))]


