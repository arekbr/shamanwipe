def zajmij_blokade():
    """Blokada operacji na dyskach (kasowanie, inwentarz, nwipe, AUTOMAT): jedna naraz na komputerze, niezależnie od
    konsoli. Zwalnia ją zamknięcie pliku albo koniec procesu. Otwarty plik albo None (zajęta)."""
    os.makedirs(KATALOG_RUN, exist_ok=True)
    f = open(PLIK_BLOKADY, 'a')
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return f
    except BlockingIOError:
        f.close()
        return None


def wlasciciel_blokady():
    """PID procesu trzymającego blokadę albo None — z /proc/locks, BEZ próby flock (próba w złej chwili odebrałaby
    blokadę konsoli, która właśnie startuje AUTOMAT)."""
    try:
        st = os.stat(PLIK_BLOKADY)
    except OSError:
        return None
    for linia in czytaj('/proc/locks').splitlines():
        p = linia.split()  # '1: FLOCK  ADVISORY  WRITE 1234 00:1a:5678 0 EOF'; '->' = proces czekający
        if len(p) < 6 or p[1] != 'FLOCK' or '->' in p:
            continue
        try:
            maj, mn, ino = p[5].split(':')
            if int(ino) == st.st_ino and int(maj, 16) == os.major(st.st_dev) and int(mn, 16) == os.minor(st.st_dev):
                return int(p[4])
        except ValueError:
            continue
    return None


