WZORZEC_RAID_SPRZETOWY = re.compile(
    r'PERC|MegaRAID|Smart Array|LOGICAL VOLUME|ServeRAID|Adaptec|AVAGO|LSI\b|MR\d{4}|RAID|Virtual Disk', re.I)


def dyski_pod(nazwa, glebokosc=0):
    """Zbiór dysków fizycznych pod urządzeniem blokowym (partycja → dysk, dm → slaves, loop → plik → dysk)."""
    if glebokosc > 8 or not nazwa:
        return set()
    nazwa = os.path.basename(nazwa)
    sys_ = f'/sys/class/block/{nazwa}'
    if not os.path.exists(sys_):
        return set()
    if os.path.exists(f'{sys_}/partition'):
        rodzic = os.path.basename(os.path.dirname(os.path.realpath(sys_)))
        return dyski_pod(rodzic, glebokosc + 1)
    slaves = glob.glob(f'{sys_}/slaves/*')
    if slaves:
        wynik = set()
        for s in slaves:
            wynik |= dyski_pod(os.path.basename(s), glebokosc + 1)
        return wynik
    plik = czytaj(f'{sys_}/loop/backing_file')
    if plik:  # chroniony i sam loop, i dysk, na którym leży jego plik (findiso=, Ventoy)
        rc, out, _ = uruchom(['findmnt', '-n', '-o', 'SOURCE', '-T', plik], timeout=10)
        return {nazwa} | (dyski_pod(out.strip().split('[')[0], glebokosc + 1) if rc == 0 else set())
    return {nazwa}


def nosnik_startowy():
    """(chronione: {dysk: powód}, jednoznaczny: bool) — dyski nośnika live i dyski z etykietą ISO/raportów."""
    chronione, jednoznaczny = {}, False
    rc, out, _ = uruchom(['findmnt', '-n', '-o', 'SOURCE', '/run/live/medium'], timeout=10)
    for zrodlo in out.split():
        dyski = dyski_pod(zrodlo.split('[')[0])
        for d in dyski:
            chronione[d] = L('nośnik startowy (live)', 'boot medium (live)')
        jednoznaczny = jednoznaczny or bool(dyski)
    # Etykiety sondowane bezpośrednio (blkid -c /dev/null), NIE z bazy udev: lsblk bez udev zwraca pustą etykietę,
    # a wtedy nośnik z etykietą SHAMANWIPE nie byłby chroniony.
    for etykieta in (ETYKIETA_ISO, ETYKIETA_RAPORTOW):
        rc, out, _ = uruchom(['blkid', '-c', '/dev/null', '-o', 'device', '-t', f'LABEL={etykieta}'], timeout=30)
        for urz in out.split():
            for dysk in dyski_pod(urz):
                chronione.setdefault(dysk, L(f'nośnik z etykietą {etykieta}', f'medium labelled {etykieta}'))
                if etykieta == ETYKIETA_ISO:
                    jednoznaczny = True
    return chronione, jednoznaczny


def zamontowane_dyski():
    rc, out, _ = uruchom(['lsblk', '-J', '-o', 'NAME,MOUNTPOINTS,TYPE'], timeout=20)
    wynik, swapy = {}, czytaj('/proc/swaps')

    def ma(r):
        mp = [m for m in (r.get('mountpoints') or []) if m]
        if mp or f"/dev/{r['name']} " in swapy:
            return mp or ['[swap]']
        for c in r.get('children') or []:
            x = ma(c)
            if x:
                return x
        return None
    try:
        for urz in json.loads(out).get('blockdevices', []):
            x = ma(urz)
            if x:
                wynik[urz['name']] = x
    except ValueError:
        pass
    return wynik


def zawartosc_dysku(sciezka):
    rc, out, _ = uruchom(['lsblk', '-n', '-r', '-o', 'FSTYPE', sciezka], timeout=20)
    return sorted({x for x in out.split() if x})


def kontroler_nvme(nazwa):
    b = os.path.basename(os.path.realpath(f'/sys/block/{nazwa}/device'))
    if re.fullmatch(r'nvme\d+', b):
        return '/dev/' + b
    m = re.match(r'(nvme\d+)n\d+', nazwa)
    return '/dev/' + m.group(1) if m else None


def liczba_namespace(kontroler):
    k = os.path.basename(kontroler)
    return len([p for p in glob.glob(f'/sys/class/nvme/{k}/{k}n*') if re.fullmatch(rf'{k}n\d+', os.path.basename(p))]) or 1


def szyna_usb(nazwa):
    """Identyfikator urządzenia USB (np. '2-1.3') — polecenia firmware na jednym mostku idą szeregowo."""
    m = re.findall(r'/(\d+-[\d.]+)(?=/)', os.path.realpath(f'/sys/block/{nazwa}'))
    return m[-1] if m else None


def smart_json(sciezka, transport):
    rc, js, _ = uruchom(['smartctl', '-x', '-j', sciezka], timeout=90)
    s = parsuj_smart(js)
    # Przez mostek USB bez -d sat tabela atrybutów bywa PUSTA (wygląda jak dysk bez błędów)
    if s.get('godziny_pracy') is None and not sciezka.startswith('/dev/nvme'):
        rc2, js2, _ = uruchom(['smartctl', '-x', '-j', '-d', 'sat', sciezka], timeout=90)
        s2 = parsuj_smart(js2)
        if s2.get('godziny_pracy') is not None:
            return s2, js2
    return s, js


def badaj_dysk(d):
    sc = d['sciezka']
    d['smart_przed'], d['smart_przed_surowy'] = smart_json(sc, d.get('transport'))
    d['zawartosc'] = zawartosc_dysku(sc)
    d['rozmiar_urzadzenia_b'] = d['rozmiar_b']
    d['serial_zrodlo'] = 'lsblk'

    if d['nazwa'].startswith('nvme'):
        d['interfejs'], d['typ_nosnika'] = 'nvme', 'NVMe SSD'
        ktrl = kontroler_nvme(d['nazwa'])
        nv = {}
        rc, out, _ = uruchom(['nvme', 'id-ctrl', ktrl, '-o', 'json'], timeout=30)
        if rc == 0:
            try:
                nv = parsuj_nvme_id_ctrl(out)
            except (ValueError, TypeError):
                nv = {}
        rc, out, _ = uruchom(['nvme', 'id-ns', sc, '-o', 'json'], timeout=30)
        if rc == 0:
            try:
                nv['ns'] = parsuj_nvme_id_ns(out)
                d['rozmiar_identify_b'] = nv['ns'].get('rozmiar_b')
            except (ValueError, TypeError, IndexError):
                pass
        rc, out, _ = uruchom(['nvme', 'sanitize-log', ktrl, '-o', 'json'], timeout=30)
        if rc == 0:
            try:
                nv['sstat_przed'] = int(znajdz_klucze(json.loads(out), {'sstat'}).get('sstat', 0))
            except ValueError:
                pass
        nv['kontroler'] = ktrl
        nv['liczba_ns'] = liczba_namespace(ktrl) if ktrl else 1
        d['nvme'] = nv
        if nv.get('serial'):
            d['serial'], d['serial_zrodlo'] = nv['serial'], 'NVMe Identify'
        for k in ('model', 'firmware'):
            d[k] = nv.get(k) or d.get(k)
    elif d['nazwa'].startswith('mmcblk'):
        d['interfejs'] = 'mmc'
        d['typ_nosnika'] = 'eMMC' if czytaj(f'/sys/block/{d["nazwa"]}/device/type') == 'MMC' else 'SD'
    else:
        rc, out, _ = uruchom(['hdparm', '-I', sc], timeout=30)
        ata = parsuj_hdparm_I(out) if rc == 0 else None
        if ata:
            d['interfejs'] = 'ata'
            rc, out, _ = uruchom(['hdparm', '-N', sc], timeout=20)
            ata['hpa'] = parsuj_hdparm_N(out)
            rc, out, _ = uruchom(['hdparm', '--dco-identify', sc], timeout=20)
            ata['dco_max'] = parsuj_dco(out)
            if ata['sanitize']['obslugiwany']:
                rc, out, _ = uruchom(['hdparm', '--sanitize-status', sc], timeout=20)
                ata['sanitize_stan_przed'] = ocen_sanitize_status(out)[0]
            d['ata'] = ata
            if ata.get('serial'):
                d['serial'], d['serial_zrodlo'] = ata['serial'], 'ATA IDENTIFY'
            for k in ('model', 'firmware'):
                d[k] = ata.get(k) or d.get(k)
            d['rozmiar_identify_b'] = ata['sektory'] * ata['sektor_logiczny'] if ata['sektory'] else None
            d['typ_nosnika'] = {True: 'SSD', False: 'HDD'}.get(ata.get('ssd'), '')
        else:
            rc, out, _ = uruchom(['sg_opcodes', sc], timeout=30)
            s = parsuj_sg_opcodes(out) if rc == 0 else {'crypto': False, 'block': False, 'overwrite': False}
            if any(s.values()):
                d['interfejs'], d['scsi'] = 'scsi', {'sanitize': s}
            else:
                d['interfejs'] = 'block'
        if not d.get('typ_nosnika'):
            sm = d['smart_przed']
            if sm.get('obroty') == 0:
                d['typ_nosnika'] = 'SSD'
            elif sm.get('obroty') or d.get('rota'):
                d['typ_nosnika'] = 'HDD'
            else:
                d['typ_nosnika'] = 'unknown'
    for k in ('model', 'serial', 'firmware'):
        if not d.get(k):
            d[k] = d['smart_przed'].get(k) or ''
            if k == 'serial' and d[k]:
                d['serial_zrodlo'] = 'SMART'
    if d.get('transport') == 'usb' and d['serial_zrodlo'] == 'lsblk':
        d['serial_zrodlo'] = 'usb-bridge'
    if d.get('transport') not in ('nvme', 'usb') and WZORZEC_RAID_SPRZETOWY.search(f"{d.get('vendor', '')} {d.get('model', '')}"):
        d['raid_sprzetowy'] = True
    if d.get('transport') == 'usb':
        d['szyna'] = szyna_usb(d['nazwa'])
    return d


def inwentarz(szczegolowo=True):
    rc, out, _ = uruchom(['lsblk', '-J', '-b', '-d', '-o',
                          'NAME,PATH,TYPE,TRAN,SIZE,MODEL,SERIAL,ROTA,RM,RO,VENDOR,REV,WWN,LOG-SEC'], timeout=30)
    try:
        urz = json.loads(out).get('blockdevices', [])
    except ValueError:
        urz = []
    startowe, jednoznaczny = nosnik_startowy()
    montowane = zamontowane_dyski()
    dyski = []
    tylko_loop = TRYB_TESTOWY  # testy w kontenerze: widać tam dyski VM — nie wolno ich dotknąć
    for u in urz:
        n = u.get('name', '')
        if tylko_loop:
            if not n.startswith('loop') or not int(u.get('size') or 0):
                continue
        elif u.get('type') != 'disk' or re.match(r'(loop|ram|zram|sr|fd|md|dm-|nbd)', n):
            continue
        d = {'nazwa': n, 'sciezka': u.get('path') or f'/dev/{n}', 'transport': (u.get('tran') or ''),
             'rozmiar_b': int(u.get('size') or 0), 'model': (u.get('model') or '').strip(),
             'serial': (u.get('serial') or '').strip(), 'vendor': (u.get('vendor') or '').strip(),
             'firmware': (u.get('rev') or '').strip(), 'wwn': u.get('wwn') or '', 'rota': bool(u.get('rota')),
             'sektor_logiczny': int(u.get('log-sec') or 512), 'chroniony': []}
        if n in startowe:
            d['chroniony'].append(startowe[n])
        if n in montowane:
            d['chroniony'].append(L('zamontowany: ', 'mounted: ') + ', '.join(montowane[n]))
        if u.get('ro'):
            d['chroniony'].append(L('urządzenie tylko do odczytu', 'read-only device'))
        if d['rozmiar_b'] == 0:
            d['chroniony'].append(L('rozmiar 0 (brak nośnika)', 'size 0 (no media)'))
        dyski.append(d)
    if szczegolowo:
        watki = [threading.Thread(target=badaj_dysk, args=(d,)) for d in dyski]
        for w in watki:
            w.start()
        for w in watki:
            w.join()
    sn = {}
    for d in dyski:
        if d.get('serial'):
            sn.setdefault(d['serial'], []).append(d)
    for lista in sn.values():
        if len(lista) > 1:
            for d in lista:
                d['chroniony'].append(L('ten sam numer seryjny ma kilka urządzeń (multipath/mostek) — wyjaśnij ręcznie',
                                        'several devices report the same serial number (multipath/bridge) — resolve manually'))
    inwentarz.nosnik_jednoznaczny = jednoznaczny
    return dyski


inwentarz.nosnik_jednoznaczny = False


def tozsamosc(d):
    return {'serial': d.get('serial') or '', 'rozmiar_b': d.get('rozmiar_b')}


def odczytaj_tozsamosc(d):
    """Aktualny S/N i rozmiar pod ścieżką dysku (do porównania tuż przed poleceniem niszczącym)."""
    sc = d['sciezka']
    serial = ''
    if d.get('interfejs') == 'nvme':
        rc, out, _ = uruchom(['nvme', 'id-ctrl', d['nvme']['kontroler'], '-o', 'json'], timeout=30)
        try:
            serial = parsuj_nvme_id_ctrl(out)['serial'] if rc == 0 else ''
        except (ValueError, TypeError):
            serial = ''
    elif d.get('interfejs') == 'ata':
        rc, out, _ = uruchom(['hdparm', '-I', sc], timeout=30)
        a = parsuj_hdparm_I(out)
        serial = a['serial'] if a else ''
    else:
        rc, out, _ = uruchom(['lsblk', '-n', '-d', '-o', 'SERIAL', sc], timeout=10)
        serial = out.strip()
        if not serial and d.get('serial_zrodlo') == 'SMART':
            serial = parsuj_smart(uruchom(['smartctl', '-i', '-j', sc], timeout=60)[1]).get('serial') or ''
    return {'serial': serial, 'rozmiar_b': rozmiar_urzadzenia(sc)}


def zgodna_tozsamosc(zapisana, biezaca):
    if zapisana['serial'] and biezaca['serial'] != zapisana['serial']:
        return False
    return biezaca['rozmiar_b'] == zapisana['rozmiar_b']


