def tabela_dyskow(dyski, z_planem=True):
    linie = [f' {L("DYSK", "DISK"):<10}{"TRANSP.":<8}{L("TYP", "TYPE"):<10}{L("ROZMIAR", "SIZE"):>10}  {"MODEL":<26}{"S/N":<22}'
             + (L('METODA', 'METHOD') if z_planem else '')]
    for d in dyski:
        p = d.get('plan') or {}
        if d.get('chroniony'):
            metoda = L('CHRONIONY: ', 'PROTECTED: ') + '; '.join(d['chroniony'])
        elif p and not p.get('mozliwe', True):
            metoda = L('NIE DA SIĘ: ', 'NOT POSSIBLE: ') + ' '.join(p.get('uwagi', []))
        else:
            metoda = f"{kod(p.get('klasa', ''))}: {p.get('technika', '')}" if p else ''
        linie.append(f' {d["nazwa"]:<10}{d.get("transport") or "-":<8}{kod(d.get("typ_nosnika", "?")):<10}{czytelny_rozmiar(d["rozmiar_b"]):>10}  '
                     f'{str(d.get("model"))[:25]:<26}{str(d.get("serial"))[:21]:<22}' + (metoda if z_planem else ''))
    return '\n'.join(linie)


