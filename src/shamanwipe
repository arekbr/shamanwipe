def metody_sprzetowe(d, kontrolery_wspolne=None):
    """Lista metod sprzętowych w kolejności preferencji + uwagi + blokada (powód, gdy kasowanie niemożliwe)."""
    uwagi, wynik = [], []
    interfejs = d.get('interfejs', 'block')
    nosnik = d.get('typ_nosnika', 'unknown')
    if d.get('raid_sprzetowy'):
        uwagi.append(L('Wolumen kontrolera RAID sprzętowego: polecenia firmware nie dotrą do dysków. Dla metody sprzętowej '
                       'przełącz kontroler w tryb HBA/JBOD. Możliwy tylko nadpis wolumenu, bez potwierdzenia zakresu.',
                       'Hardware RAID controller volume: firmware commands cannot reach the drives. For a hardware method '
                       'switch the controller to HBA/JBOD mode. Only a volume overwrite is possible, without range confirmation.'))
        return [], uwagi, None
    if interfejs == 'nvme':
        nv = d.get('nvme', {})
        s = nv.get('sanitize', {})
        if (nv.get('sstat_przed') or 0) & 7 == 2:
            return [], uwagi, L('NVMe: poprzedni Sanitize nadal w toku — poczekaj na jego koniec i uruchom ponownie',
                                'NVMe: a previous Sanitize is still in progress — wait for it to finish and run again')
        if (nv.get('sstat_przed') or 0) & 7 == 3:
            uwagi.append(L('NVMe: poprzedni Sanitize zakończony błędem — wymagany ponowny Sanitize',
                           'NVMe: the previous Sanitize failed — a new Sanitize is required'))
        caly = nv.get('liczba_ns', 1) == 1 or bool(kontrolery_wspolne and nv.get('kontroler') in kontrolery_wspolne)
        if caly:
            wynik += [m for m, k in (('nvme-sanitize-crypto', 'crypto'), ('nvme-sanitize-block', 'block'),
                                     ('nvme-sanitize-overwrite', 'overwrite')) if s.get(k)]
            if nv.get('liczba_ns', 1) > 1 and any(s.values()):
                uwagi.append(L('Sanitize obejmuje cały kontroler — wszystkie namespace, także nieprzyłączone.',
                               'Sanitize covers the whole controller — all namespaces, including unattached ones.'))
        elif any(s.values()):
            uwagi.append(L('Kontroler NVMe ma kilka namespace, nie wszystkie wybrane — Sanitize (cały kontroler) pominięty.',
                           'The NVMe controller has several namespaces, not all selected — Sanitize (whole controller) skipped.'))
        if nv.get('format_obslugiwany'):
            if nv.get('format_wszystkie_ns') and not caly:
                uwagi.append(L('Format NVM działa na wszystkie namespace kontrolera — pominięty.',
                               'Format NVM applies to all namespaces of the controller — skipped.'))
            else:
                if nv.get('format_crypto'):
                    wynik.append('nvme-format-crypto')
                wynik.append('nvme-format-user')
    elif interfejs == 'ata':
        a = d.get('ata', {})
        s, b = a.get('sanitize', {}), a.get('bezpieczenstwo', {})
        if b.get('zablokowane'):
            return [], uwagi, L('Dysk ZABLOKOWANY hasłem ATA poprzedniego właściciela — bez hasła (user/master) '
                                'albo PSID nie da się go skasować. NIE przechodzę na nadpis.',
                                'Drive LOCKED with the previous owner\'s ATA password — it cannot be erased without the '
                                'password (user/master) or PSID. NOT falling back to overwrite.')
        if a.get('sanitize_stan_przed') == 'W_TOKU':
            return [], uwagi, L('ATA: poprzedni SANITIZE nadal w toku — poczekaj na koniec',
                                'ATA: a previous SANITIZE is still in progress — wait for it to finish')
        if s.get('crypto'):
            wynik.append('ata-sanitize-crypto')
        if s.get('block') and nosnik != 'HDD':
            wynik.append('ata-sanitize-block')
        if s.get('overwrite'):
            wynik.append('ata-sanitize-overwrite')
        if b.get('obslugiwane') and not b.get('licznik_wyczerpany'):
            if b.get('wlaczone'):
                uwagi.append(L('Hasło ATA już ustawione (dysk odblokowany przez BIOS?) — Security Erase pominięty.',
                               'ATA password already set (drive unlocked by the BIOS?) — Security Erase skipped.'))
            else:
                if b.get('enhanced'):
                    wynik.append('ata-se-enhanced')
                wynik.append('ata-se-normal')
    elif interfejs == 'scsi':
        s = d.get('scsi', {}).get('sanitize', {})
        if s.get('crypto'):
            wynik.append('scsi-sanitize-crypto')
        if s.get('block') and nosnik != 'HDD':
            wynik.append('scsi-sanitize-block')
        if s.get('overwrite'):
            wynik.append('scsi-sanitize-overwrite')
    elif interfejs == 'mmc' and nosnik == 'eMMC':
        wynik.append('mmc-discard-sanitize')
    return wynik, uwagi, None


def wybierz_metode(d, profil='standard', kontrolery_wspolne=None, automat=False):
    """Plan dla dysku: kroki, zapasowe, klasa, technika, przygotowanie, uwagi, mozliwe."""
    plan = {'kroki': [], 'zapasowe': [], 'uwagi': [], 'przygotowanie': [], 'mozliwe': True}
    if d.get('chroniony'):
        plan['mozliwe'] = False
        plan['uwagi'].append(L('Dysk chroniony: ', 'Protected disk: ') + '; '.join(d['chroniony']))
        return plan
    if automat and d.get('raid_sprzetowy'):
        plan['mozliwe'] = False
        plan['uwagi'].append(L('AUTOMAT pomija wolumeny RAID sprzętowego (zakresu nie da się potwierdzić).',
                               'AUTO skips hardware RAID volumes (the erase range cannot be confirmed).'))
        return plan
    sprzetowe, uwagi, blokada = metody_sprzetowe(d, kontrolery_wspolne)
    plan['uwagi'] += uwagi
    if blokada:
        plan['mozliwe'] = False
        plan['uwagi'].append(blokada)
        return plan
    if d.get('transport') == 'usb' and d.get('interfejs') == 'block':
        plan['uwagi'].append(L('Mostek USB nie przepuszcza poleceń ATA/SCSI — możliwy tylko nadpis, bez IDENTIFY zakres '
                               'niepotwierdzony. Mostek UAS (np. VIA VL711) bywa do obejścia: `shamanwipe usb-bot`.',
                               'The USB bridge does not pass ATA/SCSI commands — only an overwrite is possible, and without '
                               'IDENTIFY the range is unconfirmed. A UAS bridge (e.g. VIA VL711) can often be worked around: '
                               '`shamanwipe usb-bot`.'))

    profil = ALIASY_PROFILI.get(profil, profil)
    if profil == 'overwrite':
        kroki = ['overwrite-zeros']
    elif profil == 'max':
        kroki = ['overwrite-random'] + (sprzetowe[:1] if sprzetowe else ['overwrite-zeros'])
    else:
        kroki = sprzetowe[:1] if sprzetowe else ['overwrite-zeros']
    plan['kroki'] = kroki
    plan['zapasowe'] = [m for m in sprzetowe if m not in kroki] + ([] if 'overwrite-zeros' in kroki else ['overwrite-zeros'])

    a = d.get('ata', {})
    if any(k.startswith('ata-se') for k in kroki) and a.get('bezpieczenstwo', {}).get('zamrozone'):
        plan['przygotowanie'].append('unfreeze')
        plan['uwagi'].append(L('Dysk „frozen” — przed Security Erase próba odmrożenia przez uśpienie komputera.',
                               'Drive is "frozen" — before Security Erase the computer is suspended briefly to unfreeze it.'))
    hpa = a.get('hpa') or {}
    if hpa.get('hpa_wlaczony') or (a.get('dco_max') and a.get('sektory') and a['dco_max'] > a['sektory']):
        plan['przygotowanie'].append('restore-max-lba')
        plan['uwagi'].append(L('Wykryto ukryty obszar (HPA/DCO) — przed kasowaniem przywracany pełny rozmiar.',
                               'Hidden area detected (HPA/DCO) — the full capacity is restored before erasure.'))
    uzupelnij_plan(plan, d)
    return plan


def uzupelnij_plan(plan, d):
    kroki = plan['kroki']
    klasy = {METODY[k][0] for k in kroki}
    plan['klasa'] = 'PURGE' if 'PURGE' in klasy else 'CLEAR'
    if (d.get('interfejs') == 'block' and d.get('transport') == 'usb') or d.get('raid_sprzetowy'):
        plan['klasa'] = 'NONE'
    plan['technika'] = ' → '.join(METODY[k][1] for k in kroki)
    plan['uwagi_metody'] = [METODY[k][2] for k in kroki if METODY[k][2]]
    rodziny = {METODY[k][3] for k in kroki if METODY[k][3] != 'host'}
    plan['niezweryfikowane_na_sprzecie'] = sorted(r for r in rodziny if r not in ZWERYFIKOWANE_NA_SPRZECIE)
    ost = kroki[-1] if kroki else ''
    plan['weryfikacja'] = (L('pełny odczyt — każdy bajt = 0x00', 'full read-back — every byte = 0x00')
                           if ost in ('overwrite-zeros', 'mmc-discard-sanitize')
                           else L(f'znaczniki: {LICZBA_PROBEK} × {ROZMIAR_PROBKI // 1024} KiB zapisane przed kasowaniem, '
                                  'po kasowaniu każdy musi zniknąć + stan urządzenia + brak sygnatur',
                                  f'markers: {LICZBA_PROBEK} × {ROZMIAR_PROBKI // 1024} KiB written before erasure, each must '
                                  'be gone afterwards + device state + no signatures'))


def plan_dla_wszystkich(dyski, profil, wybrane=None, automat=False):
    wybrane = set(wybrane) if wybrane is not None else {d['sciezka'] for d in dyski if not d.get('chroniony')}
    ns, wyb = {}, {}
    for d in dyski:
        k = d.get('nvme', {}).get('kontroler')
        if k:
            ns[k] = ns.get(k, 0) + 1
            if d['sciezka'] in wybrane and not d.get('chroniony'):
                wyb[k] = wyb.get(k, 0) + 1
    wspolne = {k for k, n in ns.items() if wyb.get(k) == n}
    for d in dyski:
        if d['sciezka'] in wybrane:
            d['plan'] = wybierz_metode(d, profil, wspolne, automat)
            d['tozsamosc'] = tozsamosc(d)
    return [d for d in dyski if d['sciezka'] in wybrane]


# ---------------------------------------------------------------------------------------------
# Odczyt/zapis bezpośredni (O_DIRECT) i weryfikacja
# ---------------------------------------------------------------------------------------------
class UrzadzenieBlokowe:
    def __init__(self, sciezka, zapis=False):
        flagi = os.O_RDWR if zapis else os.O_RDONLY
        self.direct = True
        try:
            self.fd = os.open(sciezka, flagi | os.O_DIRECT)
        except OSError:
            self.fd = os.open(sciezka, flagi)
            self.direct = False
        self.rozmiar = os.lseek(self.fd, 0, os.SEEK_END)

    def czytaj(self, bufor, poz, dl):
        n = os.preadv(self.fd, [memoryview(bufor)[:dl]], poz)
        if not self.direct:
            os.posix_fadvise(self.fd, poz, dl, os.POSIX_FADV_DONTNEED)
        return n

    def pisz(self, bufor, poz, dl):
        return os.pwritev(self.fd, [memoryview(bufor)[:dl]], poz)

    def zamknij(self):
        try:
            os.fsync(self.fd)
        except OSError:
            pass
        os.close(self.fd)


def pozycje_probek(rozmiar, n=LICZBA_PROBEK, wielkosc=ROZMIAR_PROBKI):
    if rozmiar <= wielkosc:
        return [0]
    poz = {0, (rozmiar - wielkosc) // 4096 * 4096}
    for i in range(1, n - 1):
        poz.add(((rozmiar - wielkosc) * i // (n - 1)) // 4096 * 4096)
    return sorted(poz)


def czytaj_probki(sciezka, pozycje):
    u = UrzadzenieBlokowe(sciezka)
    buf = mmap.mmap(-1, ROZMIAR_PROBKI)
    wynik = []
    try:
        for p in pozycje:
            dl = min(ROZMIAR_PROBKI, u.rozmiar - p)
            try:
                n = u.czytaj(buf, p, dl)
                dane = buf[:n]
                jedn = len(set(dane)) == 1
                wynik.append({'pozycja': p, 'sha256': hashlib.sha256(dane).hexdigest(), 'jednolita': jedn})
            except OSError as e:
                wynik.append({'pozycja': p, 'blad': str(e)})
    finally:
        u.zamknij()
        buf.close()
    return wynik


def zapisz_znaczniki(sciezka, pozycje):
    """Zapisuje losowe znaczniki w pozycjach próbek i odczytuje je z powrotem (O_DIRECT).

    Po kasowaniu sprzętowym każdy znacznik musi zniknąć — dzięki temu weryfikacja jest informatywna także na dysku,
    który przed kasowaniem był pusty. Zwraca (lista {pozycja, sha256, jednolita}, odczyt_zgodny: bool).
    """
    u = UrzadzenieBlokowe(sciezka, zapis=True)
    buf = mmap.mmap(-1, ROZMIAR_PROBKI)
    zapisane = []
    try:
        for p in pozycje:
            dl = min(ROZMIAR_PROBKI, u.rozmiar - p)
            buf[:dl] = os.urandom(dl)
            u.pisz(buf, p, dl)
            zapisane.append({'pozycja': p, 'sha256': hashlib.sha256(buf[:dl]).hexdigest(), 'jednolita': False})
    finally:
        u.zamknij()
        buf.close()
    uruchom(['blockdev', '--flushbufs', sciezka], timeout=60)
    odczyt = czytaj_probki(sciezka, pozycje)
    zgodny = all(o.get('sha256') == z['sha256'] for o, z in zip(odczyt, zapisane))
    return zapisane, zgodny


def ocen_probki(przed, po):
    """Próbka po kasowaniu OK, gdy jednolita (0x00/0xFF/…) albo różna od stanu przed.

    Identyczna jak przed i niejednolita = dane przetrwały = NIEPOWODZENIE. Błąd odczytu = NIEPOWODZENIE.
    """
    mapa = {p['pozycja']: p for p in przed}
    ok = przetrwaly = bledy = nierozstrz = 0
    for q in po:
        if 'blad' in q:
            bledy += 1
            continue
        p = mapa.get(q['pozycja'])
        if p is None or 'blad' in p:
            nierozstrz += 1
            continue
        if q['sha256'] == p['sha256']:
            if p['jednolita']:
                nierozstrz += 1
            else:
                przetrwaly += 1
        else:
            ok += 1
    return {'zaliczona': przetrwaly == 0 and bledy == 0 and ok > 0, 'probek': len(po), 'zmienione_lub_jednolite': ok,
            'identyczne_jak_przed_niejednolite': przetrwaly, 'nierozstrzygniete': nierozstrz, 'bledy_odczytu': bledy}


