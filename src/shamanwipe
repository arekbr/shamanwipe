def dane_systemu():
    def dmi(k):
        rc, out, _ = uruchom(['dmidecode', '-s', k], timeout=20)
        return out.strip() if rc == 0 else ''
    cpu = next((l.split(':', 1)[1].strip() for l in czytaj('/proc/cpuinfo').splitlines() if l.startswith('model name')), '')
    pamiec = next((int(l.split()[1]) * 1024 for l in czytaj('/proc/meminfo').splitlines() if l.startswith('MemTotal')), 0)
    wersje = {}
    for p in ('openseachest', 'nvme-cli', 'hdparm', 'sg3-utils', 'smartmontools', 'nwipe', 'mmc-utils', 'util-linux'):
        rc, out, _ = uruchom(['dpkg-query', '-W', '-f', '${Version}', p], timeout=20)
        wersje[p] = out.strip() if rc == 0 else 'missing'
    rc, sync, _ = uruchom(['timedatectl', 'show', '-p', 'NTPSynchronized', '--value'], timeout=10)
    rc, lspci, _ = uruchom(['lspci'], timeout=20)
    return {'producent': dmi('system-manufacturer'), 'model': dmi('system-product-name'),
            'numer_seryjny': dmi('system-serial-number'), 'uuid': dmi('system-uuid'),
            'plyta_glowna': f"{dmi('baseboard-manufacturer')} {dmi('baseboard-product-name')}".strip(),
            'procesor': cpu, 'pamiec_b': pamiec, 'czas_z_ntp': sync.strip() == 'yes', 'strefa': time.strftime('%Z'),
            'rozruch': 'UEFI' if os.path.isdir('/sys/firmware/efi') else 'BIOS',
            'kontrolery_raid': [l for l in lspci.splitlines() if re.search(r'RAID bus controller|Volume Management Device', l)],
            'narzedzia': wersje, 'program': f'shamanwipe {WERSJA}', 'jadro': os.uname().release}


def czytaj_operatora():
    # operator.conf na SW-REPORTS: name=, title=, organization=, location=, contact= (pola NIST SP 800-88r2 §4.6)
    op = {'name': '', 'title': '', 'organization': '', 'location': '', 'contact': ''}
    for linia in czytaj(os.path.join(MNT_RAPORTY, 'operator.conf')).splitlines():
        if '=' in linia and not linia.strip().startswith('#'):
            k, v = linia.split('=', 1)
            if k.strip() in op:
                op[k.strip()] = v.strip()
    return op


