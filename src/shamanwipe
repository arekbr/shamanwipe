class Zadanie:
    def __init__(self, dysk, profil):
        self.d = dysk
        self.profil = profil
        self.etap, self.postep, self.predkosc, self.komunikat = L('oczekuje', 'waiting'), None, None, ''
        self.wynik = None            # techniczny: OK / UNCONFIRMED / FAILED
        self.status = None           # końcowy: kod ze STATUSY
        self.zastrzezenia, self.niepotwierdzone = [], []
        self.kroki = []
        self.start = self.koniec = None
        self.weryfikacja = None
        self.znaczniki_zgodne = None
        self.zapisane_b = 0
        self.watek = None

    def _krok(self, nazwa, rc, opis='', **dod):
        k = {'nazwa': nazwa, 'rc': rc, 'opis': opis, 'czas': teraz_iso()}
        k.update(dod)
        self.kroki.append(k)
        log(f'{self.d["nazwa"]}: step {nazwa} rc={rc} {opis}')
        return rc == 0

    def stan(self):
        return {'dysk': self.d['nazwa'], 'model': self.d.get('model'), 'serial': self.d.get('serial'), 'etap': self.etap,
                'postep': self.postep, 'predkosc_MBs': self.predkosc, 'komunikat': self.komunikat,
                'status': self.status, 'technika': self.d.get('plan', {}).get('technika')}

    def _sprawdz_tozsamosc(self):
        biez = odczytaj_tozsamosc(self.d)
        if not zgodna_tozsamosc(self.d['tozsamosc'], biez):
            t, b = self.d['tozsamosc'], biez
            raise RuntimeError(L(f'ZMIANA TOŻSAMOŚCI DYSKU pod {self.d["sciezka"]}: było S/N {t["serial"]!r}, {t["rozmiar_b"]} B; '
                                 f'jest S/N {b["serial"]!r}, {b["rozmiar_b"]} B — przerwano',
                                 f'DISK IDENTITY CHANGED at {self.d["sciezka"]}: was S/N {t["serial"]!r}, {t["rozmiar_b"]} B; '
                                 f'now S/N {b["serial"]!r}, {b["rozmiar_b"]} B — aborted'))

    def _niszczace(self, technika, haslo_ata=False):
        """Wpis do dziennika operacji + kontrola tożsamości tuż przed poleceniem niszczącym."""
        self._sprawdz_tozsamosc()
        self._id_operacji = f'{self.d.get("serial") or self.d["nazwa"]}-{int(time.time() * 1000)}'
        dziennik({'id': self._id_operacji, 'state': 'start', 'device': self.d['sciezka'], 'serial': self.d.get('serial'),
                  'model': self.d.get('model'), 'technique': technika, 'ata_password_set': haslo_ata,
                  'ata_password': ATA_HASLO if haslo_ata else None})

    def _koniec_operacji(self, wynik):
        dziennik({'id': getattr(self, '_id_operacji', '?'), 'state': 'end', 'result': wynik})

    def _zapisz_znaczniki(self):
        """Znaczniki (512 próbek losowych) to ZAPIS na dysk: wpis do dziennika + kontrola tożsamości jak przed każdym niszczącym."""
        self.etap = L('znaczniki przed kasowaniem', 'markers before erasure')
        self._niszczace(L('znaczniki przed kasowaniem (próbki losowe)', 'markers before erasure (random samples)'))
        try:
            return zapisz_znaczniki(self.d['sciezka'], pozycje_probek(self.d['rozmiar_b']))
        finally:
            self._koniec_operacji('markers')

    def _blokada_szyny(self):
        szyna = self.d.get('szyna')
        if not szyna:
            return None
        with _blokada_szyn:
            return _blokady_szyn.setdefault(szyna, threading.Lock())

    def _openseachest(self, argumenty, timeout):
        cmd = ['openSeaChest_Erase', '-d', self.d['sciezka'], '--noBanner'] + argumenty
        t0 = time.time()
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
        zebrane = bytearray()
        while True:
            r, _, _ = select.select([p.stdout], [], [], 2)
            if r:
                kaw = os.read(p.stdout.fileno(), 4096)
                if not kaw:
                    break
                zebrane += kaw
                m = re.findall(rb'(\d{1,3}(?:\.\d+)?)\s*%', kaw)
                if m:
                    self.postep = min(100.0, float(m[-1]))
            if time.time() - t0 > timeout:
                p.kill()
                break
        rc = p.wait()
        tekst = zebrane.decode('utf-8', 'replace')
        log(f'[{rc}] ({time.time() - t0:.0f}s) {" ".join(cmd)}\n{tekst[-20000:]}', 'commands.log')
        return rc, tekst

    # --- metody ---
    def nvme_sanitize(self, akcja):
        ktrl = self.d['nvme']['kontroler']
        self._niszczace(f'nvme sanitize sanact={akcja}')
        rc, out, err = uruchom(['nvme', 'sanitize', ktrl, f'--sanact={akcja}'], timeout=120)
        if rc != 0:
            self._koniec_operacji(L('błąd polecenia', 'command error'))
            return self._krok('nvme-sanitize', rc, (err or out).strip()[:300])
        t0 = time.time()
        while time.time() - t0 < 12 * 3600:
            time.sleep(2)
            rc2, js, _ = uruchom(['nvme', 'sanitize-log', ktrl, '-o', 'json'], timeout=30)
            try:
                v = znajdz_klucze(json.loads(js), {'sprog', 'sstat', 'cdw10_info', 'scdw10'})
            except ValueError:
                continue
            sstat, sprog = int(v.get('sstat', 0)), int(v.get('sprog', 0))
            self.postep = round(sprog * 100 / 65535, 1)
            if sstat & 7 in (1, 4):
                cdw = v.get('cdw10_info', v.get('scdw10'))
                zgodny = cdw is None or (int(cdw) & 7) == akcja
                self._koniec_operacji(L('ukończony', 'completed'))
                self.postep = 100.0
                if not zgodny:
                    self.niepotwierdzone.append(L(f'log Sanitize dotyczy innej akcji (SCDW10={cdw})',
                                                  f'the Sanitize log refers to a different action (SCDW10={cdw})'))
                return self._krok('nvme-sanitize', 0, L(f'log Sanitize: ukończony, SSTAT=0x{sstat:x}, SCDW10={cdw}',
                                                        f'Sanitize log: completed, SSTAT=0x{sstat:x}, SCDW10={cdw}'), sstat=sstat)
            if sstat & 7 == 3:
                self._koniec_operacji(L('błąd', 'error'))
                return self._krok('nvme-sanitize', 3, L(f'log Sanitize: NIEPOWODZENIE, SSTAT=0x{sstat:x}',
                                                        f'Sanitize log: FAILED, SSTAT=0x{sstat:x}'), sstat=sstat)
        self._koniec_operacji(L('przekroczony czas', 'timeout'))
        return self._krok('nvme-sanitize', 124, L('przekroczony czas oczekiwania na log Sanitize', 'timed out waiting for the Sanitize log'))

    def nvme_format(self, ses):
        nv = self.d['nvme']
        ns = nv.get('ns', {'lbaf': 0, 'ms': 0, 'pi': 0})
        self._niszczace(f'nvme format ses={ses}')
        rc, out, err = uruchom(['nvme', 'format', self.d['sciezka'], f'--lbaf={ns["lbaf"]}', f'--ses={ses}', f'--pi={ns["pi"]}',
                                f'--ms={ns["ms"]}', '--force', '--timeout=3600000'], timeout=3700)
        uruchom(['nvme', 'ns-rescan', nv['kontroler']], timeout=30)
        self._koniec_operacji('rc=%d' % rc)
        if rc == 0:
            self.postep = 100.0
        return self._krok('nvme-format', rc, (err or out).strip()[:300])

    def ata_sanitize(self, rodzaj):
        flaga = {'crypto': '--sanitize-crypto-scramble', 'block': '--sanitize-block-erase', 'overwrite': '--sanitize-overwrite'}[rodzaj]
        cmd = ['hdparm', '--yes-i-know-what-i-am-doing', flaga] + (['hex:00000000'] if rodzaj == 'overwrite' else []) + [self.d['sciezka']]
        self._niszczace(f'ATA SANITIZE {rodzaj}')
        rc, out, err = uruchom(cmd, timeout=120)
        if rc != 0:
            self._koniec_operacji(L('błąd polecenia', 'command error'))
            return self._krok('ata-sanitize', rc, (err or out).strip()[-300:])
        stan, t0 = 'W_TOKU', time.time()
        st = ''
        while time.time() - t0 < 72 * 3600:
            time.sleep(3)
            rc2, st, _ = uruchom(['hdparm', '--sanitize-status', self.d['sciezka']], timeout=30)
            stan, postep = ocen_sanitize_status(st)
            if postep is not None:
                self.postep = postep
            if stan != 'W_TOKU':
                break
        self._koniec_operacji(KODY_WYNIKU.get(stan, stan))
        if stan == 'NIEZNANY':
            self.niepotwierdzone.append(L('status SANITIZE nieczytelny po operacji', 'SANITIZE status unreadable after the operation'))
            return self._krok('ata-sanitize', 0, L(f'{rodzaj}; status nieczytelny: {st.strip()[-200:]}',
                                                   f'{rodzaj}; status unreadable: {st.strip()[-200:]}'))
        return self._krok('ata-sanitize', 0 if stan == 'OK' else 3, f'{rodzaj}; status: {st.strip()[-200:]}')

    def ata_security_erase(self, enhanced):
        sc = self.d['sciezka']
        b = self.d['ata']['bezpieczenstwo']
        szac = (b.get('czas_enh_min') if enhanced else b.get('czas_min')) or 120
        stop = threading.Event()

        def postep_czasowy():
            t0 = time.time()
            while not stop.wait(5):
                self.postep = min(99.0, round((time.time() - t0) / (szac * 60) * 100, 1))
                self.komunikat = L(f'szacowany czas wg dysku: {szac} min', f'estimated time reported by the drive: {szac} min')
        self._niszczace('ATA SECURITY ERASE ' + ('enhanced' if enhanced else 'normal'), haslo_ata=True)
        rc, out, err = uruchom(['hdparm', '--user-master', 'u', '--security-set-pass', ATA_HASLO, sc], timeout=60)
        if rc != 0:
            self._koniec_operacji(L('nie ustawiono hasła', 'password not set'))
            return self._krok('ata-security-set-pass', rc, (err or out).strip()[-300:])
        threading.Thread(target=postep_czasowy, daemon=True).start()
        rc, out, err = uruchom(['hdparm', '--user-master', 'u', '--security-erase-enhanced' if enhanced else '--security-erase',
                                ATA_HASLO, sc], timeout=max(szac * 60 * 3, 3600) + 1800)
        stop.set()
        time.sleep(2)
        rc2, tekst, _ = uruchom(['hdparm', '-I', sc], timeout=60)
        a = parsuj_hdparm_I(tekst)
        if a and (a['bezpieczenstwo'].get('wlaczone') or a['bezpieczenstwo'].get('zablokowane')):
            uruchom(['hdparm', '--user-master', 'u', '--security-unlock', ATA_HASLO, sc], timeout=60)
            uruchom(['hdparm', '--user-master', 'u', '--security-disable', ATA_HASLO, sc], timeout=60)
            rc2, tekst, _ = uruchom(['hdparm', '-I', sc], timeout=60)
        wynik, opis = ocen_po_security_erase(rc, tekst, self.d['tozsamosc']['serial'])
        self._koniec_operacji(KODY_WYNIKU.get(wynik, wynik))
        if wynik == 'UNCONFIRMED':
            self.niepotwierdzone.append(opis)
            return self._krok('ata-security-erase', 0, opis)
        if wynik == 'OK':
            self.postep = 100.0
        else:
            opis += L(f'. Odblokowanie ręczne: hdparm --user-master u --security-disable {ATA_HASLO} {sc}',
                      f'. Manual unlock: hdparm --user-master u --security-disable {ATA_HASLO} {sc}')
        return self._krok('ata-security-erase', 0 if wynik == 'OK' else 3, opis)

    def scsi_sanitize(self, rodzaj):
        arg = {'crypto': 'cryptoerase', 'block': 'blockerase', 'overwrite': 'overwrite'}[rodzaj]
        self._niszczace(f'SCSI SANITIZE {rodzaj}')
        rc, out = self._openseachest(['--sanitize', arg, '--poll'], timeout=72 * 3600)
        self._koniec_operacji('rc=%d' % rc)
        return self._krok('scsi-sanitize', rc, arg)

    def przywroc_max_lba(self):
        rc, out = self._openseachest(['--eraseRestoreMaxPrep'], timeout=300)
        rescan = f'/sys/block/{self.d["nazwa"]}/device/rescan'
        if os.path.exists(rescan):
            try:
                with open(rescan, 'w') as f:
                    f.write('1')
            except OSError:
                pass
        time.sleep(2)
        nowy = rozmiar_urzadzenia(self.d['sciezka'])
        rc2, tekst, _ = uruchom(['hdparm', '-I', self.d['sciezka']], timeout=30)
        a = parsuj_hdparm_I(tekst)
        if a:
            self.d['ata']['sektory'] = a['sektory']
            self.d['rozmiar_identify_b'] = a['sektory'] * a['sektor_logiczny']
        self.d['rozmiar_urzadzenia_b'] = nowy
        self.d['tozsamosc']['rozmiar_b'] = nowy
        return self._krok('restore-max-lba', rc, L(f'HPA/DCO/AMAC; rozmiar urządzenia po: {nowy} B',
                                                   f'HPA/DCO/AMAC; device size afterwards: {nowy} B'))

    def nadpis(self, wzorzec):  # wzorzec: 'zeros' | 'random'
        self._niszczace(L(f'nadpis ({wzorzec})', f'overwrite ({wzorzec})'))
        u = UrzadzenieBlokowe(self.d['sciezka'], zapis=True)
        buf = mmap.mmap(-1, ROZMIAR_BLOKU_IO)
        rozm, bledy, poz, t0 = u.rozmiar, 0, 0, time.time()
        gen = random.Random(random.SystemRandom().getrandbits(64))
        try:
            while poz < rozm:
                dl = min(ROZMIAR_BLOKU_IO, rozm - poz)
                if wzorzec == 'random':
                    buf[:dl] = gen.randbytes(dl)
                try:
                    zap = self._zapis_bloku(u, buf, poz, dl)
                    if zap != dl:
                        bledy += 1
                except OSError as e:
                    bledy += 1
                    log(f'{self.d["nazwa"]}: write error @ {poz}: {e}')
                    if bledy > 100:
                        break
                poz += dl
                dt = time.time() - t0
                self.postep = round(poz * 100 / rozm, 1)
                self.predkosc = round(poz / dt / 1e6, 1) if dt > 0 else None
        finally:
            u.zamknij()
            buf.close()
        uruchom(['blockdev', '--flushbufs', self.d['sciezka']], timeout=60)
        self.zapisane_b = poz
        self._koniec_operacji(L(f'zapisano {poz} B, błędy {bledy}', f'written {poz} B, errors {bledy}'))
        rc = 0 if bledy == 0 and poz >= rozm else 3
        return self._krok(f'overwrite-{wzorzec}', rc, L(f'{wzorzec}, {poz} z {rozm} B, błędy zapisu: {bledy}, O_DIRECT={u.direct}',
                                                        f'{wzorzec}, {poz} of {rozm} B, write errors: {bledy}, O_DIRECT={u.direct}'),
                          zapisane_b=poz, rozmiar_b=rozm, bledy=bledy)

    def _zapis_bloku(self, u, buf, poz, dl):  # osobna metoda: test „dysku-oszusta” podmienia ją w tests/
        return u.pisz(buf, poz, dl)

    def mmc_discard_sanitize(self):
        self._niszczace('eMMC discard + sanitize')
        rc1, o1, e1 = uruchom(['blkdiscard', '-f', self.d['sciezka']], timeout=3600)
        rc2, o2, e2 = uruchom(['mmc', 'sanitize', self.d['sciezka']], timeout=3600)
        self._koniec_operacji(f'discard rc={rc1}, sanitize rc={rc2}')
        self._krok('mmc-discard', rc1, (e1 or o1).strip()[:200])
        self._krok('mmc-sanitize', rc2, (e2 or o2).strip()[:200])
        if rc2 != 0:
            self.zastrzezenia.append(L('eMMC SANITIZE niewykonany (brak obsługi?) — zostaje discard + nadpis',
                                       'eMMC SANITIZE not performed (unsupported?) — discard + overwrite remain'))
        return self.nadpis('zeros')

    def weryfikuj_zera(self):
        self.etap = L('weryfikacja (pełny odczyt)', 'verification (full read-back)')
        u = UrzadzenieBlokowe(self.d['sciezka'])
        buf = mmap.mmap(-1, ROZMIAR_BLOKU_IO)
        zero = bytes(ROZMIAR_BLOKU_IO)
        rozm, poz, niezerowe, bledy, t0, pierwszy = u.rozmiar, 0, 0, 0, time.time(), None
        try:
            while poz < rozm:
                dl = min(ROZMIAR_BLOKU_IO, rozm - poz)
                try:
                    n = u.czytaj(buf, poz, dl)
                    if n != dl or buf[:n] != zero[:n]:
                        niezerowe += 1
                        pierwszy = poz if pierwszy is None else pierwszy
                except OSError:
                    bledy += 1
                poz += dl
                dt = time.time() - t0
                self.postep = round(poz * 100 / rozm, 1)
                self.predkosc = round(poz / dt / 1e6, 1) if dt > 0 else None
        finally:
            u.zamknij()
            buf.close()
        return {'metoda': L('pełny odczyt, każdy bajt = 0x00', 'full read-back, every byte = 0x00'), 'zweryfikowane_b': poz, 'rozmiar_b': rozm,
                'bloki_4MiB_niezerowe': niezerowe, 'bledy_odczytu': bledy, 'pierwszy_niezerowy_offset': pierwszy,
                'zaliczona': niezerowe == 0 and bledy == 0 and poz >= rozm}

    def weryfikuj_znaczniki(self, znaczniki):
        self.etap = L('weryfikacja (znaczniki)', 'verification (markers)')
        po = czytaj_probki(self.d['sciezka'], [p['pozycja'] for p in znaczniki])
        w = ocen_probki(znaczniki, po)
        w['metoda'] = L(f'znaczniki: {len(po)} × {ROZMIAR_PROBKI // 1024} KiB losowych danych zapisanych przed kasowaniem',
                        f'markers: {len(po)} × {ROZMIAR_PROBKI // 1024} KiB of random data written before erasure')
        w['zweryfikowane_b'] = len(po) * ROZMIAR_PROBKI
        rc, out, _ = uruchom(['wipefs', '-n', '-J', self.d['sciezka']], timeout=30)
        try:
            sygn = json.loads(out).get('signatures', []) if out.strip() else []
        except ValueError:
            sygn = []
        w['sygnatury_po'] = [s.get('type') for s in sygn]
        if sygn:
            w['zaliczona'] = False
        return w

    # --- przebieg ---
    def wykonaj(self):
        self.start = teraz_iso()
        plan = self.d['plan']
        try:
            if 'restore-max-lba' in plan['przygotowanie']:
                self.etap = L('przywracanie ukrytego obszaru (HPA/DCO)', 'restoring the hidden area (HPA/DCO)')
                self._niszczace(L('przywrócenie pełnego rozmiaru (HPA/DCO/AMAC)', 'restoring the full capacity (HPA/DCO/AMAC)'))
                try:
                    przywrocone = self.przywroc_max_lba()
                finally:
                    self._koniec_operacji('HPA/DCO')
                if not przywrocone:
                    if plan['kroki'][0].startswith('overwrite'):
                        raise RuntimeError(L('Nie udało się przywrócić pełnego rozmiaru (HPA/DCO) — nadpis nie obejmie całego dysku',
                                             'Could not restore the full capacity (HPA/DCO) — an overwrite would not cover the whole disk'))
                    # Nadpis przez hosta obejmuje tylko widoczny rozmiar — nie może też być rezerwą metody firmware
                    plan['zapasowe'] = [m for m in plan.get('zapasowe', []) if METODY[m][3] != 'host']
                    self.zastrzezenia.append(L('HPA/DCO nie przywrócone — polega na tym, że metoda firmware obejmuje cały nośnik',
                                               'HPA/DCO not restored — relies on the firmware method covering the whole medium'))
            znaczniki = None
            for i, k in enumerate(list(plan['kroki'])):
                sprzetowy = METODY[k][3] != 'host' and k != 'mmc-discard-sanitize'
                if sprzetowy:
                    znaczniki, self.znaczniki_zgodne = self._zapisz_znaczniki()
                    if not self.znaczniki_zgodne:
                        self.zastrzezenia.append(L('znaczniki nie odczytały się zgodnie przed kasowaniem — weryfikacja mniej informatywna',
                                                   'markers did not read back correctly before erasure — verification is less informative'))
                ok = self._z_blokada(k)
                if not ok and not self.niepotwierdzone:
                    for zap in [z for z in plan.get('zapasowe', []) if z not in plan['kroki']]:
                        log(f'{self.d["nazwa"]}: {k} failed → fallback method {zap}')
                        if METODY[zap][3] != 'host' and zap != 'mmc-discard-sanitize':
                            znaczniki, self.znaczniki_zgodne = self._zapisz_znaczniki()
                        else:
                            znaczniki = None
                        ok = self._z_blokada(zap)
                        if ok:
                            plan['kroki'][i] = zap
                            uzupelnij_plan(plan, self.d)
                            plan['uwagi'].append(L(f'Metoda {METODY[k][1]} zawiodła — użyto zapasowej: {METODY[zap][1]}',
                                                   f'Method {METODY[k][1]} failed — fallback used: {METODY[zap][1]}'))
                            break
                if not ok and not self.niepotwierdzone:
                    raise RuntimeError(L(f'Metoda {METODY[k][1]} i metody zapasowe zakończone błędem',
                                         f'Method {METODY[k][1]} and the fallback methods failed'))
            uruchom(['blockdev', '--rereadpt', self.d['sciezka']], timeout=30)
            if plan['kroki'][-1] in ('overwrite-zeros', 'mmc-discard-sanitize'):
                self.weryfikacja = self.weryfikuj_zera()
            else:
                self.weryfikacja = self.weryfikuj_znaczniki(znaczniki)
            w = self.weryfikacja
            przetrwaly = ((w.get('identyczne_jak_przed_niejednolite') or 0) > 0 or (w.get('bloki_4MiB_niezerowe') or 0) > 0
                          or bool(w.get('sygnatury_po')))
            if przetrwaly:  # dowód, że dane przetrwały, ma pierwszeństwo przed stanem „niepotwierdzonym”
                self.wynik = 'FAILED'
                self.komunikat = self.komunikat or L('weryfikacja: dane przetrwały kasowanie', 'verification: data survived the erasure')
            else:
                self.wynik = 'UNCONFIRMED' if self.niepotwierdzone else ('OK' if w.get('zaliczona') else 'FAILED')
        except Exception as e:  # noqa: BLE001 — każdy błąd = FAILED w raporcie, nie wywrotka programu
            self.komunikat = str(e)
            self.wynik = 'FAILED'
            log(f'{self.d["nazwa"]}: FAILED: {e}')
        finally:
            self.etap = L('SMART po', 'SMART after')
            self.d['smart_po'], self.d['smart_po_surowy'] = smart_json(self.d['sciezka'], self.d.get('transport'))
            self.koniec = teraz_iso()
            self.status = ustal_status(self)
            self.etap = L('zakończone', 'finished')
            log(f'{self.d["nazwa"]}: STATUS {self.status}')

    def _z_blokada(self, k):
        self.etap = METODY[k][1]
        self.postep, self.predkosc, self.komunikat = 0.0, None, ''
        blok = self._blokada_szyny() if METODY[k][3] != 'host' else None
        if blok:
            self.komunikat = L(f'czeka na mostek USB {self.d.get("szyna")}', f'waiting for USB bridge {self.d.get("szyna")}')
            with blok:
                return self._wykonaj_metode(k)
        return self._wykonaj_metode(k)

    def _wykonaj_metode(self, k):
        if k.startswith('nvme-sanitize-'):
            return self.nvme_sanitize({'crypto': 4, 'block': 2, 'overwrite': 3}[k.rsplit('-', 1)[1]])
        if k == 'nvme-format-crypto':
            return self.nvme_format(2)
        if k == 'nvme-format-user':
            return self.nvme_format(1)
        if k.startswith('ata-sanitize-'):
            return self.ata_sanitize(k.rsplit('-', 1)[1])
        if k == 'ata-se-enhanced':
            return self.ata_security_erase(True)
        if k == 'ata-se-normal':
            return self.ata_security_erase(False)
        if k.startswith('scsi-sanitize-'):
            return self.scsi_sanitize(k.rsplit('-', 1)[1])
        if k == 'mmc-discard-sanitize':
            return self.mmc_discard_sanitize()
        if k == 'overwrite-zeros':
            return self.nadpis('zeros')
        if k == 'overwrite-random':
            return self.nadpis('random')
        raise ValueError(k)


def ustal_status(z):
    """Status końcowy (kod ze STATUSY) + lista zastrzeżeń (z.zastrzezenia uzupełniane)."""
    d, plan = z.d, z.d.get('plan', {})
    if z.wynik == 'FAILED' or z.wynik is None:
        return 'FAILED'
    ident, urz = d.get('rozmiar_identify_b'), d.get('rozmiar_urzadzenia_b')
    if ident and urz and ident != urz:
        z.niepotwierdzone.append(L(f'rozmiar wg IDENTIFY {ident} B ≠ rozmiar urządzenia {urz} B',
                                   f'IDENTIFY size {ident} B ≠ device size {urz} B'))
    if plan.get('klasa') == 'NONE':
        z.niepotwierdzone.append(L('zakres kasowania niepotwierdzony (brak IDENTIFY / wolumen RAID sprzętowego)',
                                   'erase range unconfirmed (no IDENTIFY / hardware RAID volume)'))
    if z.wynik == 'UNCONFIRMED' or z.niepotwierdzone:
        return 'UNCONFIRMED'
    kroki = plan.get('kroki', [])
    tylko_host = all(METODY[k][3] == 'host' for k in kroki)
    if tylko_host and d.get('typ_nosnika') in ('SSD', 'NVMe SSD', 'eMMC', 'unknown'):
        z.zastrzezenia.append(L('nośnik flash skasowany tylko nadpisem — zapas komórek nieobjęty (NIST SP 800-88r2 §4.5.2)',
                                'flash media erased by overwrite only — spare cells not covered (NIST SP 800-88r2 §4.5.2)'))
    if tylko_host and (d.get('smart_przed', {}).get('realokowane') or 0) > 0:
        z.zastrzezenia.append(L(f'{d["smart_przed"]["realokowane"]} sektorów realokowanych — nadpis ich nie obejmuje',
                                f'{d["smart_przed"]["realokowane"]} reallocated sectors — not covered by the overwrite'))
    if d.get('serial_zrodlo') == 'usb-bridge':
        z.zastrzezenia.append(L('numer seryjny pochodzi z mostka USB, nie z dysku', 'serial number comes from the USB bridge, not the drive'))
    z.zastrzezenia += pogorszenie_smart(d.get('smart_przed', {}), d.get('smart_po', {}))
    return 'ERASED_WITH_WARNINGS' if z.zastrzezenia else 'ERASED'


def odmroz_dyski(zadania):
    """Uśpienie S3 na kilka sekund PRZED pierwszą operacją niszczącą. Po wybudzeniu: ponowna kontrola stanu i tożsamości."""
    do = [z for z in zadania if 'unfreeze' in z.d['plan']['przygotowanie']]
    if not do:
        return
    stany = czytaj('/sys/power/state')
    log(f'unfreeze: {", ".join(z.d["nazwa"] for z in do)}; /sys/power/state="{stany}" mem_sleep="{czytaj("/sys/power/mem_sleep")}"')
    if 'mem' in stany:
        print(L('Usypiam komputer na ~5 s, żeby odmrozić dyski (frozen). Jeśli sam się nie obudzi — naciśnij zasilanie.',
                'Suspending the computer for ~5 s to unfreeze the drives. If it does not wake up by itself, press the power button.'))
        uruchom(['rtcwake', '-m', 'mem', '-s', '5'], timeout=180)
        time.sleep(8)
    for z in zadania:  # po uśpieniu nazwy urządzeń mogą się przetasować — kontrola tożsamości WSZYSTKICH
        if not zgodna_tozsamosc(z.d['tozsamosc'], odczytaj_tozsamosc(z.d)):
            z.d['plan']['mozliwe'] = False
            z.d['plan']['uwagi'].append(L('Po uśpieniu pod tą ścieżką jest inny dysk — pominięty, uruchom program ponownie',
                                          'After suspend a different disk is at this path — skipped, run the program again'))
    for z in do:
        rc, tekst, _ = uruchom(['hdparm', '-I', z.d['sciezka']], timeout=30)
        a = parsuj_hdparm_I(tekst)
        if a:
            z.d['ata']['bezpieczenstwo'] = a['bezpieczenstwo']
        zamr = z.d['ata']['bezpieczenstwo'].get('zamrozone')
        z.d['plan']['odmrozenie_wynik'] = L('odmrożony', 'unfrozen') if zamr is False else L('nadal zamrożony', 'still frozen')
        if zamr:
            stare = list(z.d['plan']['kroki'])
            nowe = [k for k in z.d['plan']['zapasowe'] if not k.startswith('ata-se')]
            z.d['plan']['kroki'] = [k for k in stare if not k.startswith('ata-se')] + (nowe[:1] if not any(not k.startswith('ata-se') and METODY[k][3] != 'host' for k in stare) else [])
            if not z.d['plan']['kroki']:
                z.d['plan']['kroki'] = ['overwrite-zeros']
            z.d['plan']['uwagi'].append(L(
                'Nie udało się odmrozić (frozen) — Security Erase pominięty. Ręcznie: odłącz i podłącz zasilanie dysku przy '
                'włączonym komputerze (hot-plug) albo użyj innego komputera.',
                'Could not unfreeze the drive — Security Erase skipped. Manually: unplug and replug the drive power while the '
                'computer is on (hot-plug), or use another computer.'))
            uzupelnij_plan(z.d['plan'], z.d)


def pokaz_postep(zadania, plik_stanu):
    wiersze = []
    for z in zadania:
        s = z.stan()
        post = f'{s["postep"]:5.1f}%' if isinstance(s['postep'], (int, float)) else '   — '
        pr = f'{s["predkosc_MBs"]:.0f} MB/s' if s['predkosc_MBs'] else ''
        wiersze.append(f' {s["dysk"]:<9} {str(s["model"])[:22]:<22} {post} {pr:>9}  {s["etap"][:42]:<42} {kod(s["status"]) if s["status"] else ""}')
    sys.stdout.write('\033[2J\033[H' + f'ShamanWipe {WERSJA} — ' + L('kasowanie w toku', 'erasure in progress') +
                     f' ({teraz().strftime("%H:%M:%S")})\n\n' +
                     L(' DYSK      MODEL                  POSTĘP  PRĘDKOŚĆ  ETAP\n', ' DISK      MODEL                  PROG.      SPEED  STAGE\n') +
                     '\n'.join(wiersze) +
                     L('\n\nNIE wyłączaj komputera i NIE odłączaj dysków do końca.\n',
                       '\n\nDo NOT power off the computer or disconnect any disk until finished.\n'))
    sys.stdout.flush()
    try:
        with open(plik_stanu + '.tmp', 'w') as f:
            json.dump([z.stan() for z in zadania], f, ensure_ascii=False)
        os.replace(plik_stanu + '.tmp', plik_stanu)
    except OSError:
        pass


def kasuj(dyski, profil):
    zadania = [Zadanie(d, profil) for d in dyski if d.get('plan', {}).get('mozliwe')]
    odmroz_dyski(zadania)
    zadania = [z for z in zadania if z.d['plan'].get('mozliwe')]
    t_start = teraz_iso()
    for z in zadania:
        z.watek = threading.Thread(target=z.wykonaj, daemon=True)
        z.watek.start()
    plik_stanu = os.path.join(KATALOG_RUN, 'stan.json')
    while any(z.watek.is_alive() for z in zadania):
        pokaz_postep(zadania, plik_stanu)
        time.sleep(2)
    pokaz_postep(zadania, plik_stanu)
    return zadania, t_start


