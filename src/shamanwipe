def czytelny_rozmiar(b):
    if b is None:
        return '?'
    b = float(b)
    for jedn in ('B', 'kB', 'MB', 'GB', 'TB', 'PB'):
        if b < 1000 or jedn == 'PB':
            return f'{int(b)} B' if jedn == 'B' else f'{b:.1f} {jedn}'
        b /= 1000.0


